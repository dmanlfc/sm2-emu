//
// Texture sheet decode: unpacks the 4-bit-per-texel texture RAM into a directly
// indexable image once per upload rather than once per fragment tap.
//
// Model 2 packs four texels per 32-bit word: byte by local y parity, nibble by
// local x parity, halfword by the physical address's bit 1. Because the
// byte/nibble choice depends on the draw's mip level and base position, only the
// word fetch and nibble split can be precomputed. Each invocation handles one
// halfword container and writes its four nibbles to one pixel; polygon.frag then
// selects a channel, giving bit-identical results.
//
// Decoded pixel layout:
//   R = y even, x even     G = y even, x odd
//   B = y odd,  x even     A = y odd,  x odd

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/// Both texture sheets, back to back, as polygon.frag sees them.
layout(std430, set = 0, binding = 0) readonly buffer Sheets { uint uSheet[]; };

/// One pixel per 2x2-texel container: 512x1024 per sheet, one layer per sheet.
layout(set = 0, binding = 1, rgba8ui) writeonly uniform uimage2DArray uDecoded;

/// Words in one sheet, matching polygon.frag's kSheetWords.
const uint kSheetWords = 0x40000u;

const uint kContainersX = 512u;
const uint kContainersY = 1024u;

void main()
{
    const uint cx    = gl_GlobalInvocationID.x;  // 0..511
    const uint cy     = gl_GlobalInvocationID.y;  // 0..1023
    const uint layer = gl_GlobalInvocationID.z;  // which sheet, 0 or 1

    if (cx >= kContainersX || cy >= kContainersY) {
        return;
    }

    // (cx, cy) is fetchTexel's (x2>>1, y2>>1), so this reads the same word.
    const uint offset = cy * kContainersX + cx;
    const uint index  = offset >> 1;

    uint word = 0u;
    if (index < kSheetWords) {
        word = uSheet[layer * kSheetWords + index];
    }
    const uint halfword = ((offset & 1u) != 0u) ? (word >> 16) : (word & 0xffffu);

    const uint byte_even_y = (halfword >> 8) & 0xffu;  // fetchTexel's y&1==0 case
    const uint byte_odd_y  = halfword & 0xffu;         // fetchTexel's y&1!=0 case

    const uvec4 nibbles = uvec4(
        (byte_even_y >> 4) & 0xfu,  // R: y even, x even
        byte_even_y & 0xfu,         // G: y even, x odd
        (byte_odd_y >> 4) & 0xfu,   // B: y odd,  x even
        byte_odd_y & 0xfu           // A: y odd,  x odd
    );

    imageStore(uDecoded, ivec3(int(cx), int(cy), int(layer)), nibbles);
}
