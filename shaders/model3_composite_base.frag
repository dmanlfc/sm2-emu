// The Real3D base layer, blended over the frame. Pair with fullscreen_quad.vert.
#version 450

layout(set = 0, binding = 0) uniform sampler2D tex1;  // base layer

layout(location = 0) out vec4 fragColor;

void main()
{
    ivec2 tc = ivec2(gl_FragCoord.xy);
    fragColor = texelFetch(tex1, tc, 0);
}
