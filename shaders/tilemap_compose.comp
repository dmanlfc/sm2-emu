//
// GPU tilemap composite: produces the same two 496x384 surfaces as
// hw::Model2Video::compose(), one invocation per output pixel.
//
// segaic24.cpp's draw_rect() scatters runs from a decoded source map; this is a
// gather instead. For each of the four layers in priority order it works out
// which source pixel the layer contributes here, samples tile and character RAM
// directly, and keeps the winner. The rules are re-derived from draw() and
// draw_split() rather than transliterated:
//
//   Layer priority. compose() draws layers 3..0, each as category 0 then 1, as
//   last-write-wins overwrites, with pair B's category-0 call opaque (pen 0
//   included). So the first layer from 0 up that draws here wins, its category
//   picking below or above: see compositeLayers().
//
//   Window mask. A clear bit selects the even ("screen") layer of a pair, a set
//   bit the odd ("window") layer; maskVisible() applies that sense directly
//   instead of draw()'s `if (win) m = ~m;`.
//
//   Split modes. Only the even layer of a pair reaches draw_split(); the mask
//   never applies, the opaque/category test still does. In every sub-case the
//   source coordinate is `(h + dx) & 0x1ff` / `(v + dy) & 0x1ff`, because
//   draw_region's offsets cancel modulo 512 at the boundary; only the chosen
//   layer varies by side. resolveSplit() returns that layer.
//
//   The scroll signs (horizontal negated and vertical as-is in plain mode, the
//   reverse in split modes) follow segaic24.cpp's draw_split() comment.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Machine memory, read raw -- no host-side decode.
// ---------------------------------------------------------------------------

/// Tile RAM, 0x10000 bytes, as little-endian 16-bit words like
/// Segaic24Tile::tile_word(), two per uint.
layout(std430, set = 0, binding = 0) readonly buffer TileRam { uint uTileRam[]; };

/// Character RAM, 0x80000 bytes, packed four bytes per uint: character c's row
/// y occupies bytes [c*32 + y*4, c*32 + y*4 + 3].
layout(std430, set = 0, binding = 1) readonly buffer CharRam { uint uCharRam[]; };

/// Model2Video::m_pens: 0x1000 premultiplied RGBA8 entries, one per uint.
layout(std430, set = 0, binding = 2) readonly buffer Pens { uint uPens[]; };

/// below and above, one packed RGBA8 pixel per uint, row-major.
layout(std430, set = 0, binding = 3) writeonly buffer Below { uint uBelow[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Above { uint uAbove[]; };

#ifdef SM2_TARGET_GL
layout(binding = 0) uniform Push {
#else
layout(push_constant) uniform Push {
#endif
    // Output width: the screen plus `columns` on each side in widescreen.
    uint width;
    uint columns;
    // 0: plain side bars. Otherwise draw the layers behind the 3D across the
    // side columns too, mirroring the screen edge as a last resort (1),
    // leaving black where only a mirror would do (2), or only where that
    // mirror is of a menu panel, a row-scroll layer's foreground tile (3).
    // The layers in front are the HUD and stay on the 4:3 screen. Bits 28-31
    // are the layers whose HUD spreads to the edges, by `hud`.
    uint wideBelow;
    // Per layer (see render::PanoramaTracker): whether the panorama applies,
    // the world column of the screen's left edge, and the live epoch.
    uint  cacheable;
    uvec4 offset;
    uvec4 offsetY;
    uvec4 epoch;
    // A game's own 360-degree panorama for one layer (see
    // Model2MachineBase::SkyPanorama): layer + 1 (0 for none), the panorama
    // pixel at screen x = 0, the map row of its first row, and its row count.
    uvec4 sky;
    // Per layer, a bit per map row that loops without being rewritten.
    uvec4 wrapLow;
    uvec4 wrapHigh;
    // A spread HUD, per band of 48 rows (two to a word, 16 bits each): the
    // column the left-hand HUD reaches to and the one the right-hand HUD
    // starts at, both halved; 0 where that side has none.
    uvec4 hud;
} pc;

/// What each layer has shown, by layer, world column and world row, as pairs:
/// pen in bits 11:0, category in bit 12, opaque texel in bit 13 and epoch in
/// bits 31:16; then the full world column and row, since slots alias.
layout(std430, set = 0, binding = 5) buffer Panorama { uint uPanorama[]; };

const uint kPanoramaWidth = 1024u;

// ---------------------------------------------------------------------------
// Constants mirrored from segaic24.h / segaic24.cpp
// ---------------------------------------------------------------------------

const uint kScreenWidth  = 496u;
const uint kScreenHeight = 384u;
const uint kCellsWide    = 64u;
const uint kTileMask     = 0x3fffu;

const uint kNameTableWords   = 0x1000u;  // per layer, in words (4096 cells)
const uint kRowScrollTable   = 0x4000u;  // +0x200 words per layer
const uint kHorizontalScroll = 0x5000u;  // +1 word per layer
const uint kVerticalScroll   = 0x5004u;  // +1 word per layer
const uint kWindowMaskA      = 0x6000u;  // 4 words/line, 64 flags of 8px
const uint kWindowMaskB      = 0x6800u;

// ---------------------------------------------------------------------------
// Raw memory access
// ---------------------------------------------------------------------------

uint tileWord(uint wordIndex)
{
    uint word32 = uTileRam[wordIndex >> 1u];
    return ((wordIndex & 1u) != 0u) ? (word32 >> 16u) : (word32 & 0xffffu);
}

/// decode_tile_pixel(): byte index tile*32 + ((y*4 + (x>>1)) ^ 1), high nibble
/// for even x.
uint tilePixel(uint tile, uint x, uint y)
{
    uint byteIndex   = tile * 32u + ((y * 4u + (x >> 1u)) ^ 1u);
    uint word32      = uCharRam[byteIndex >> 2u];
    uint byteInWord  = byteIndex & 3u;
    uint byteValue   = (word32 >> (byteInWord * 8u)) & 0xffu;
    return ((x & 1u) == 0u) ? (byteValue >> 4u) : (byteValue & 0xfu);
}

/// decode_tile_cell() plus decode_tile_pixel() at map coordinates (sx, sy).
/// Returns a pen even for a transparent texel, since opaque mode draws it;
/// `outOpaque` says whether the nibble was non-zero.
void sampleTileAt(uint layer, uint sx, uint sy, out uint outPen, out uint outCategory,
                  out bool outOpaque)
{
    uint cellX     = (sx >> 3u) & (kCellsWide - 1u);
    uint cellY     = (sy >> 3u) & (kCellsWide - 1u);
    uint cellIndex = cellY * kCellsWide + cellX;

    uint value       = tileWord(layer * kNameTableWords + cellIndex);
    uint tile        = value & kTileMask;
    uint paletteBase = ((value >> 7u) & 0xffu) * 16u;
    outCategory      = ((value & 0x8000u) != 0u) ? 1u : 0u;

    uint nibble = tilePixel(tile, sx & 7u, sy & 7u);
    outPen      = paletteBase + nibble;
    outOpaque   = nibble != 0u;
}

/// Window mask visibility at screen (dx, dy) for `layer`.
bool maskVisible(uint layer, uint dx, uint dy)
{
    uint maskBase = ((layer & 2u) != 0u) ? kWindowMaskB : kWindowMaskA;
    uint wordIdx  = maskBase + dy * 4u + (dx >> 7u);
    uint bitIdx   = (dx & 127u) >> 3u;
    bool rawBit   = ((tileWord(wordIdx) >> (15u - bitIdx)) & 1u) != 0u;
    bool isWindow = (layer & 1u) != 0u;
    return isWindow ? rawBit : !rawBit;
}

/// Plain-mode source coordinate for `layer` at screen (dx, dy): horizontal
/// scroll negated (or per-line from the row-scroll table when bit 15 of the
/// horizontal register is set), vertical scroll as-is.
void plainSource(uint layer, uint dx, uint dy, out uint sx, out uint sy)
{
    uint hscr = tileWord(kHorizontalScroll + layer);
    uint vscr = tileWord(kVerticalScroll + layer);
    uint h;
    if ((hscr & 0x8000u) != 0u) {
        h = (0u - tileWord(kRowScrollTable + 0x200u * layer + dy)) & 0x1ffu;
    } else {
        h = (0u - hscr) & 0x1ffu;
    }
    uint v = vscr & 0x1ffu;
    sx = (h + dx) & 0x1ffu;
    sy = (v + dy) & 0x1ffu;
}

/// Split-mode layer choice and source coordinate for the pair whose even
/// member is `evenLayer` (0 or 2), at screen (dx, dy).
void resolveSplit(uint evenLayer, uint mode, uint dx, uint dy, out uint chosen, out uint sx,
                  out uint sy)
{
    uint hscr = tileWord(kHorizontalScroll + evenLayer);
    uint vscr = tileWord(kVerticalScroll + evenLayer);
    uint v    = vscr & 0x1ffu;
    uint h;

    if (mode == 1u) {
        // Horizon split: a Y boundary, negated vertical scroll.
        if ((hscr & 0x8000u) != 0u) {
            h = (0u - tileWord(kRowScrollTable + 0x200u * evenLayer + dy)) & 0x1ffu;
        } else {
            h = (0u - hscr) & 0x1ffu;
        }
        // Bit 9 must be tested before masking to 0x1ff.
        uint negVFull = 0u - vscr;
        uint boundary = negVFull & 0x1ffu;
        uint first    = ((negVFull & 0x200u) != 0u) ? evenLayer : (evenLayer ^ 1u);
        chosen        = (dy >= boundary) ? (first ^ 1u) : first;
    } else {
        // Modes 2 and 3, identical: a vertical (X) boundary.
        uint boundary;
        uint left;
        if ((hscr & 0x8000u) != 0u) {
            uint raw = tileWord(kRowScrollTable + 0x200u * evenLayer + dy);
            boundary = raw & 0x1ffu;
            h        = (0u - raw) & 0x1ffu;
            left     = ((raw & 0x200u) != 0u) ? evenLayer : (evenLayer ^ 1u);
        } else {
            boundary = hscr & 0x1ffu;
            h        = (0u - hscr) & 0x1ffu;
            left     = ((hscr & 0x200u) != 0u) ? evenLayer : (evenLayer ^ 1u);
        }
        chosen = (dx < boundary) ? left : (left ^ 1u);
    }

    sx = (h + dx) & 0x1ffu;
    sy = (v + dy) & 0x1ffu;
}

/// The texel `layer` shows at (dx, dy); false where blanked or masked off.
bool sampleLayerAt(uint layer, uint maskDx, uint dx, uint dy, out uint pen, out uint category,
                   out bool opaqueTexel);

/// One layer's contribution at screen (dx, dy): true if it draws, with its
/// pen. `opaqueMode` draws unconditionally (subject to blanking and the
/// window mask); otherwise a hit additionally needs an opaque texel whose
/// category matches `requireCategory`.
bool evalLayerAt(uint layer, uint requireCategory, bool opaqueMode, uint maskDx, uint dx,
                 uint dy, out uint pen)
{
    uint category;
    bool opaqueTexel;
    return sampleLayerAt(layer, maskDx, dx, dy, pen, category, opaqueTexel)
        && (opaqueMode || (opaqueTexel && category == requireCategory));
}

bool evalLayer(uint layer, uint requireCategory, bool opaqueMode, uint dx, uint dy,
              out uint pen)
{
    return evalLayerAt(layer, requireCategory, opaqueMode, dx, dx, dy, pen);
}

/// sampleLayerAt() with the window mask taken at `maskDx`.
bool sampleLayerAt(uint layer, uint maskDx, uint dx, uint dy, out uint pen, out uint category,
                   out bool opaqueTexel)
{
    pen         = 0u;
    category    = 0u;
    opaqueTexel = false;

    // Blanking is bit 15 of the layer's own vertical-scroll register, checked
    // first as draw() does.
    uint layerVscr = tileWord(kVerticalScroll + layer);
    if ((layerVscr & 0x8000u) != 0u) {
        return false;
    }

    uint evenLayer = layer & ~1u;
    uint ctrl      = tileWord(kVerticalScroll + evenLayer);
    uint mode      = (ctrl >> 13u) & 3u;

    uint sx, sy;
    if (mode != 0u) {
        if ((layer & 1u) != 0u) {
            return false;  // odd layer: no-op call in split mode
        }
        uint chosen;
        resolveSplit(evenLayer, mode, dx, dy, chosen, sx, sy);
        sampleTileAt(chosen, sx, sy, pen, category, opaqueTexel);
    } else {
        if (!maskVisible(layer, maskDx, dy)) {
            return false;
        }
        plainSource(layer, dx, dy, sx, sy);
        sampleTileAt(layer, sx, sy, pen, category, opaqueTexel);
    }
    return true;
}

// ---------------------------------------------------------------------------
// Widescreen panorama
// ---------------------------------------------------------------------------

uint panoramaTag(uint layer, uint dx, uint dy)
{
    return ((pc.offset[layer] + dx) & 0xffffu) | (((pc.offsetY[layer] + dy) & 0xffffu) << 16u);
}

uint panoramaIndex(uint layer, uint dx, uint dy)
{
    uint column = (pc.offset[layer] + dx) & (kPanoramaWidth - 1u);
    uint row    = (pc.offsetY[layer] + dy) & 511u;
    return ((layer * kPanoramaWidth + column) * 512u + row) * 2u;
}

void recordPanorama(uint dx, uint dy)
{
    for (uint layer = 0u; layer < 4u; ++layer) {
        if (((pc.cacheable >> layer) & 1u) == 0u) {
            continue;
        }
        uint sx, sy, pen, category;
        bool opaqueTexel;
        uint chosen = layer;
        if (((tileWord(kVerticalScroll + (layer & ~1u)) >> 13u) & 3u) != 0u) {
            resolveSplit(layer, 1u, dx, dy, chosen, sx, sy);
        } else {
            plainSource(layer, dx, dy, sx, sy);
        }
        sampleTileAt(chosen, sx, sy, pen, category, opaqueTexel);
        uint index = panoramaIndex(layer, dx, dy);
        uPanorama[index] =
            pen | (category << 12u) | (opaqueTexel ? (1u << 13u) : 0u) | (pc.epoch[layer] << 16u);
        uPanorama[index + 1u] = panoramaTag(layer, dx, dy);
    }
}

/// The sky panorama's names follow the cache, 256 cells by 64 rows, two to a
/// word.
const uint kSkyNames = 4u * kPanoramaWidth * 512u * 2u;

/// Side column `sx` of the sky layer, from the game's own panorama: 1 draws,
/// 0 does not, -1 leaves it to the cache (another layer, a row it lacks).
int skySide(uint layer, uint requireCategory, bool opaqueMode, int sx, uint dy, out uint pen)
{
    pen = 0u;
    if (pc.sky.w == 0u || (layer & ~1u) != ((pc.sky.x - 1u) & ~1u)
        || (tileWord(kVerticalScroll + layer) & 0x8000u) != 0u) {
        return -1;
    }
    uint chosen = layer;
    uint sx0, sy;
    uint mode = (tileWord(kVerticalScroll + (layer & ~1u)) >> 13u) & 3u;
    if (mode == 1u) {
        if ((layer & 1u) != 0u) {
            return 0;
        }
        resolveSplit(layer, mode, 0u, dy, chosen, sx0, sy);
    } else if (mode == 0u) {
        plainSource(layer, 0u, dy, sx0, sy);
    } else {
        return -1;
    }
    uint row = sy >> 3u;
    if (chosen != pc.sky.x - 1u || row < pc.sky.z || row >= pc.sky.z + pc.sky.w) {
        return -1;
    }
    uint px    = (pc.sky.y + uint(sx)) & 2047u;
    uint index = (row - pc.sky.z) * 256u + (px >> 3u);
    uint word  = uPanorama[kSkyNames + (index >> 1u)];
    uint value = ((index & 1u) != 0u) ? (word >> 16u) : (word & 0xffffu);
    uint nibble = tilePixel(value & kTileMask, px & 7u, sy & 7u);
    pen = ((value >> 7u) & 0xffu) * 16u + nibble;
    uint category = ((value & 0x8000u) != 0u) ? 1u : 0u;
    return (opaqueMode || (nibble != 0u && category == requireCategory)) ? 1 : 0;
}

/// Whether the map row `layer` shows on screen row `dy` loops without being
/// rewritten, so the side columns can read it directly.
bool wrapsAt(uint layer, uint dy)
{
    uint row  = (((tileWord(kVerticalScroll + layer) & 0x1ffu) + dy) & 0x1ffu) >> 3u;
    uint bits = row < 32u ? pc.wrapLow[layer] : pc.wrapHigh[layer];
    return ((bits >> (row & 31u)) & 1u) != 0u;
}

/// evalLayer() for a side column `sx` (off the screen): the game's panorama
/// where it has one, else the map where its row loops, else the cache where
/// it has seen that column, else the screen mirrored at `mirrorDx`, which
/// `mirrored` reports so the caller can refuse it.
bool evalLayerSide(uint layer, uint requireCategory, bool opaqueMode, uint mirrorDx, int sx,
                   uint dy, out uint pen, out bool mirrored)
{
    mirrored = false;
    int sky  = skySide(layer, requireCategory, opaqueMode, sx, dy, pen);
    if (sky >= 0) {
        return sky != 0;
    }
    if (((pc.cacheable >> layer) & 1u) != 0u && wrapsAt(layer, dy)) {
        return evalLayerAt(layer, requireCategory, opaqueMode, mirrorDx, uint(sx), dy, pen);
    }
    bool split = ((tileWord(kVerticalScroll + (layer & ~1u)) >> 13u) & 3u) != 0u;
    if (((pc.cacheable >> layer) & 1u) != 0u && (split || maskVisible(layer, mirrorDx, dy))) {
        uint index = panoramaIndex(layer, uint(sx), dy);
        uint entry = uPanorama[index];
        if ((entry >> 16u) == pc.epoch[layer]
            && uPanorama[index + 1u] == panoramaTag(layer, uint(sx), dy)) {
            pen = entry & 0xfffu;
            return opaqueMode
                || ((entry & (1u << 13u)) != 0u && ((entry >> 12u) & 1u) == requireCategory);
        }
    }
    mirrored = evalLayer(layer, requireCategory, opaqueMode, mirrorDx, dy, pen);
    return mirrored;
}

/// A foreground-category tile on a row-scroll layer at screen (dx, dy): how
/// a menu panel is built, where a scene's backdrop is background category.
bool menuTile(uint layer, uint dx, uint dy)
{
    if ((tileWord(kHorizontalScroll + layer) & 0x8000u) == 0u
        || ((tileWord(kVerticalScroll + (layer & ~1u)) >> 13u) & 3u) != 0u) {
        return false;
    }
    uint sx, sy, pen, category;
    bool opaqueTexel;
    plainSource(layer, dx, dy, sx, sy);
    sampleTileAt(layer, sx, sy, pen, category, opaqueTexel);
    return category == 1u;
}

/// The colour behind the 3D at side column `sx`. `refused` is set when it
/// would only be a mirror this game wants left black.
uint compositeSide(uint mirrorDx, int sx, uint dy, out bool refused)
{
    uint pen;
    bool mirrored;
    refused = false;
    for (uint layer = 0u; layer < 4u; ++layer) {
        if (evalLayerSide(layer, 0u, layer >= 2u, mirrorDx, sx, dy, pen, mirrored)) {
            uint mode = pc.wideBelow & 0xffu;
            refused = mirrored && (mode == 2u || (mode == 3u && menuTile(layer, mirrorDx, dy)));
            return uPens[pen];
        }
    }
    return 0u;
}

/// The screen column a side column `sx` mirrors.
uint mirrorOf(int sx)
{
    return uint(sx < 0 ? -1 - sx : min(sx, 2 * int(kScreenWidth) - 1 - sx));
}

// ---------------------------------------------------------------------------
// Composite
// ---------------------------------------------------------------------------

/// The topmost layer wins whatever its category, layer 0 over 1 over 2 over 3,
/// as compose() mixes them; that pixel's category then puts it in `below` or
/// `above`. Within a layer a category-one texel beats pair B's opaque draw.
/// Premultiplied RGBA8, all zeroes where nothing drew, which is what
/// TilemapPass's fragment shader expects.
void compositeLayers(uint dx, uint dy, out uint below, out uint above)
{
    below = 0u;
    above = 0u;
    for (uint layer = 0u; layer < 4u; ++layer) {
        uint pen, category;
        bool opaqueTexel;
        if (!sampleLayerAt(layer, dx, dx, dy, pen, category, opaqueTexel)) {
            continue;
        }
        if (opaqueTexel && category == 1u) {
            above = uPens[pen];
            return;
        }
        if (layer >= 2u || (opaqueTexel && category == 0u)) {
            below = uPens[pen];
            return;
        }
    }
}

/// compositeLayers() over only the layers in `mask`.
void compositeMasked(uint dx, uint dy, uint mask, out uint below, out uint above)
{
    below = 0u;
    above = 0u;
    for (uint layer = 0u; layer < 4u; ++layer) {
        uint pen, category;
        bool opaqueTexel;
        if (((mask >> layer) & 1u) == 0u || !sampleLayerAt(layer, dx, dx, dy, pen, category, opaqueTexel)) {
            continue;
        }
        if (opaqueTexel && category == 1u) {
            above = uPens[pen];
            return;
        }
        if (layer >= 2u || (opaqueTexel && category == 0u)) {
            below = uPens[pen];
            return;
        }
    }
}

uint composite(uint category, uint dx, uint dy)
{
    uint below, above;
    compositeLayers(dx, dy, below, above);
    return category == 0u ? below : above;
}

/// The front layers' colour at the screen's edge on row `dy` if the row is one
/// colour for the first few pixels in, else 0.
uint solidEdge(bool left, uint dy)
{
    uint edge   = left ? 0u : kScreenWidth - 1u;
    uint colour = composite(1u, edge, dy);
    if ((colour >> 24u) == 0u) {
        return 0u;
    }
    const uint kInward[3] = uint[3](2u, 4u, 6u);
    for (uint i = 0u; i < 3u; ++i) {
        if (composite(1u, left ? kInward[i] : edge - kInward[i], dy) != colour) {
            return 0u;
        }
    }
    return colour;
}

/// A front-layer bar (a letterbox, a panel) that reaches the screen's edge
/// carries on into the side columns; anything else, the HUD's text and art,
/// stays on the screen. A bar is solid on the rows around it too, which a
/// textured row (brushed metal, a gradient) is not.
uint aboveSide(bool left, uint dy)
{
    uint colour = solidEdge(left, dy);
    if (colour == 0u) {
        return 0u;
    }
    uint same = 0u;
    for (int step = -2; step <= 2; ++step) {
        int row = int(dy) + step;
        if (step != 0 && row >= 0 && row < int(kScreenHeight)
            && solidEdge(left, uint(row)) == colour) {
            ++same;
        }
    }
    return same >= 2u ? colour : 0u;
}

void main()
{
    uint ox = gl_GlobalInvocationID.x;
    uint dy = gl_GlobalInvocationID.y;
    if (ox >= pc.width || dy >= kScreenHeight) {
        return;
    }

    // Off the screen the map holds nothing current (games rewrite it as they
    // scroll), so the side columns come from the panorama or a mirror.
    int  sx       = int(ox) - int(pc.columns);
    bool onScreen = sx >= 0 && sx < int(kScreenWidth);
    uint dx       = mirrorOf(sx);

    // GL's PBO upload puts buffer row 0 at V=0, but the pipeline expects the
    // top of the image at high V, so flip rows here rather than on the CPU.
#ifdef SM2_TARGET_GL
    uint index = (kScreenHeight - 1u - dy) * pc.width + ox;
#else
    uint index = dy * pc.width + ox;
#endif
    // Without 3D to widen, the side columns are plain black bars.
    const uint kOpaqueBlack = 0xff000000u;
    uint mode        = pc.wideBelow & 0xffu;
    uint spreadMask  = pc.wideBelow >> 28u;
    if (onScreen) {
        if (pc.columns != 0u) {
            recordPanorama(dx, dy);
        }
        uint below, above;
        if (spreadMask != 0u) {
            compositeMasked(dx, dy, ~spreadMask & 0xfu, below, above);
        } else {
            compositeLayers(dx, dy, below, above);
        }
        uBelow[index] = below;
        uAbove[index] = above;
    } else {
        uint below = kOpaqueBlack;
        if (mode != 0u) {
            bool refused;
            below = compositeSide(dx, sx, dy, refused);
            if (refused) {
                below = kOpaqueBlack;
            }
        }
        uBelow[index] = below;
        uAbove[index] = mode != 0u && spreadMask == 0u ? aboveSide(sx < 0, dy) : 0u;
    }

    // The spread HUD. An output column can show screen column ox (the left
    // part, moved out), ox - c (staying in the middle) or ox - 2c (the right
    // part). What lies within a band's bounds is HUD and moves; anything else,
    // a centred message, stays. The HUD layers' pixels behind the 3D move too.
    if (spreadMask != 0u) {
        uint band       = min(dy / 48u, 7u);
        uint bounds     = (pc.hud[band >> 1u] >> (16u * (band & 1u))) & 0xffffu;
        uint leftReach  = 2u * (bounds & 0xffu);
        uint rightStart = 2u * (bounds >> 8u);
        uint c          = pc.columns;
        uvec2 left   = uvec2(0u);  // below, above
        uvec2 middle = uvec2(0u);
        uvec2 right  = uvec2(0u);
        if (ox < leftReach) {
            compositeMasked(ox, dy, spreadMask, left.x, left.y);
        }
        uint src = ox - c;
        if (ox >= c && src < kScreenWidth && src >= leftReach && (rightStart == 0u || src < rightStart)) {
            compositeMasked(src, dy, spreadMask, middle.x, middle.y);
        }
        if (rightStart != 0u && ox >= 2u * c + rightStart && ox < 2u * c + kScreenWidth) {
            compositeMasked(ox - 2u * c, dy, spreadMask, right.x, right.y);
        }
        uvec2 shown = (left.x | left.y) != 0u     ? left
                    : (right.x | right.y) != 0u   ? right
                                                  : middle;
        if (shown.x != 0u) {
            uBelow[index] = shown.x;
        }
        if (shown.y != 0u) {
            uAbove[index] = shown.y;
        }
    }
}
