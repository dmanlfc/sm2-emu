msgid ""
"Show the aiming crosshair and hide the mouse cursor,\n"
"for the light-gun titles (Virtua Cop 2, House of the\n"
"Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)."
msgstr ""
"Zobrazí zaměřovač a skryje kurzor myši\n"
"ve hrách pro pistoli (Virtua Cop 2, House of the\n"
"Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)."

#: src/osd/gui.cpp
#, no-c-format
msgid "Show crosshair"
msgstr "Zobrazit zaměřovač"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw sm2-emu's own crosshair. Turn off if the gun\n"
"has its own sight (e.g. a Sinden). Positional-gun\n"
"titles always draw their own regardless."
msgstr ""
"Kreslí vlastní zaměřovač sm2-emu. Vypněte, pokud má\n"
"pistole vlastní mušku (např. Sinden). Hry s pozičními\n"
"pistolemi kreslí svůj vždy."

#: src/osd/gui.cpp
#, no-c-format
msgid "Hide shot flash"
msgstr "Skrýt záblesk výstřelu"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Hide the white flash Virtua Cop, Virtua Cop 2 and\n"
"House of the Dead show on each shot."
msgstr ""
"Skryje bílý záblesk, který Virtua Cop, Virtua Cop 2 a\n"
"House of the Dead ukazují při každém výstřelu."

#: src/osd/gui.cpp
#, no-c-format
msgid "Player 1 aims with the mouse; the left button fires and the right button reloads (shoot off screen)."
msgstr "Hráč 1 míří myší; levé tlačítko střílí a pravé nabíjí (výstřel mimo obrazovku)."

#: src/osd/gui.cpp
#, no-c-format
msgid "Recoil"
msgstr "Zpětný ráz"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Kick the gun's rumble motor on each shot, for guns\n"
"that have one (Sinden and similar). No effect on a\n"
"gun without a motor."
msgstr ""
"Při každém výstřelu spustí vibrační motor pistole,\n"
"pokud ho má (Sinden a podobné). U pistole bez\n"
"motoru nemá vliv."

