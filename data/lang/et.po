msgstr "Musashi - Motorola 68000 CPU tuum (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - Yamaha FM helituumad (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - aknad, sisend ja heli"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - see kasutajaliides (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - games.xml parsimine"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - ZIP-arhiivide lahtipakkimine"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - 7-Zip-arhiivide lahtipakkimine (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - GPU mälu (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - varjutite kompileerimine"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - karbipiltide dekodeerimine (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "Mängupuldi pilt - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - kujunduse allalaadimine (valikuline)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - teksti kujundamine tõlgete jaoks"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - paremalt vasakule teksti paigutus (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Mängude kujundus ja kirjeldused ArcadeDB-st"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, autor Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Täielik komponentide autorsus on failis NOTICE."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Kui soovid arendust toetada:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Salvesta seaded"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Salvestatud: %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Rool ühendatud."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Rooli pole ühendatud. Seaded rakenduvad, kui see ühendatakse."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Jõutagasiside"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Rooli jõud sõidumängudes: tsentreerimis- ja kurvijõud,\n"
"mis on dekodeeritud mängu enda roolijuhtplaadi käskudest,\n"
"pluss löögitõuge, kui millegagi kokku põrkad."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Takistus"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Pööra jõutagasiside ümber"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"Roolile, mille draiver lükkab valele poole: see tõmbab\n"
"keskelt eemale, selle asemel et tagasi tuua, ja mängu\n"
"jõud toimivad vastupidi."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibratsioon"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibreerib mängu löökide ajal, jõutagasisideta roolidele.\n"
"See ei tööta kunagi koos jõutagasisidega."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Vibratsiooni tugevus"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Mootori vibratsioon"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"Lisatud vibratsioon, mis kasvab koos gaasiga. See ei\n"
"tule mängust. Lülita välja, et tunda ainult mängu jõutagasisidet."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u°"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Roolimisulatus"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Määra see oma rooli enda pöördenurgale. Allolev\n"
"lukunurk kaardistatakse sellele, nii et vastavus\n"
"annab arkaadilaadse reageerimise."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Lukunurk"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d°"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Kui palju füüsiliselt pöörata täislukuni mängus (kokku,\n"
"seega pool kummalegi poole). Väiksem on tundlikum."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Teljed"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr "Tuvastatud automaatselt. Kalibreeri uuesti, kui rool või pedaal on vale."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Roolimine"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Gaas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Brake"
msgstr "Pidur"

#: src/osd/gui.cpp
#, no-c-format
msgid "auto"
msgstr "auto"

#: src/osd/gui.cpp
#, c-format
