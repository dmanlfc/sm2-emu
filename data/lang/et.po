msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Täisekraan"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "FPS-loendur"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
