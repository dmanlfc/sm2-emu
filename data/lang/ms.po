msgstr "miniz - nyahmampatan arkib ZIP"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - nyahmampatan arkib 7-Zip (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - memori GPU (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - pengkompilan shader"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - penyahkodan imej seni kotak (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "Gambar pad permainan - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - pengambilan karya seni (pilihan)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - pembentukan teks untuk terjemahan"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - susun atur teks kanan-ke-kiri (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Karya seni dan perihalan permainan dari ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, oleh Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Lihat NOTICE untuk atribusi penuh setiap komponen."

#: src/osd/gui.cpp
