#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Tunggu vertical blank sebelum menampilkan.\n"
"Mencegah tearing tetapi menambah latensi hingga satu frame."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notifikasi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Otomatis (sistem)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Bahasa"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Otomatis (terbaik)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Perangkat lunak"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Renderer mana yang menggambar game. Berlaku pada\n"
"peluncuran berikutnya - simpan pengaturan lalu buka ulang."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Ukuran jendela"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Lebar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Tinggi"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (asli)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Skala render 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Resolusi render 3D internal. Lebih tinggi = 3D lebih tajam\n"
"(2D/HUD tetap tajam). Hanya backend GPU; renderer perangkat\n"
"lunak tetap asli. Berlaku pada peluncuran berikutnya -\n"
"simpan pengaturan lalu buka ulang."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinear"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Bilangan bulat"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Terdekat"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Bilinear tajam"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Penskalaan 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Cara frame diperbesar ke jendela.\n"
"Bilinear tajam menjaga teks 2D tetap tajam tanpa kedipan\n"
"yang muncul pada terdekat di ukuran non-bulat. Bilangan bulat\n"
"menyesuaikan ke kelipatan utuh (piksel sempurna, dengan bilah\n"
"hitam). Berlaku langsung."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Piksel persegi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Regangkan"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Rasio aspek"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 adalah bentuk monitor arcade (bawaan).\n"
"Piksel persegi menampilkan 496x384 mentah (sedikit sempit).\n"
"Regangkan mengisi seluruh jendela. Berlaku langsung."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filter CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Tampilan kosmetik monitor arcade di atas frame akhir:\n"
"scanline, shadow mask RGB, cahaya, dan kelengkungan layar\n"
"opsional. Murni visual; berlaku langsung."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanline"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Mask"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Cahaya"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Kelengkungan"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Peningkatan (kosmetik, melampaui perangkat keras asli)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotropik"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Setia"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filter tekstur 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(tidak didukung)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "GPU ini tidak melaporkan dukungan filter anisotropik."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropi"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Upscale 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Haluskan tepi lapisan 2D (HUD, teks, menu). xBR dan\n"
"ScaleFX membulatkan diagonal; Setia menjaga piksel tajam.\n"
"Berlaku langsung."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Dicampur"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Stipple"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Transparansi"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Perangkat keras menggambar permukaan tembus pandang (lampu,\n"
"kaca, bayangan) sebagai pola papan catur. Dicampur menggambar\n"
"permukaan 50% tembus pandang yang dituju. Berlaku langsung."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Tekstur kustom"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Ganti tekstur 3D game dengan gambar yang disimpan di\n"
"saves/textures/<game>/load, dengan nama hasil dump. Hanya\n"
"renderer GPU; Muat ulang membaca berkas yang diedit."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu dimuat"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Muat ulang"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Dump tekstur"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Kumpulkan setiap tekstur 3D yang digambar game dan tulis,\n"
"dengan index.html untuk menelusuri, ke saves/textures/<game>/dump\n"
"saat game ditutup atau opsi ini dimatikan."

