#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw sm2-emu's own crosshair. Turn off if the gun\n"
"has its own sight (e.g. a Sinden). Positional-gun\n"
"titles always draw their own regardless."
msgstr ""
"Gambar crosshair milik sm2-emu. Matikan jika senjata\n"
"punya bidikan sendiri (mis. Sinden). Game senjata\n"
"posisional selalu menggambar milik sendiri."

