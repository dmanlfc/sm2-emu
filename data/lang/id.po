#, no-c-format
msgid ""
"A bright frame around the game image that a Sinden\n"
"gun's camera tracks for aiming. Only shown in\n"
"light-gun mode."
msgstr ""
"Bingkai terang di sekitar gambar game yang dilacak\n"
"kamera senjata Sinden untuk membidik. Hanya tampil\n"
"dalam mode light gun."

#: src/osd/gui.cpp
#, no-c-format
msgid "Show border"
msgstr "Tampilkan bingkai"

#: src/osd/gui.cpp
#, no-c-format
