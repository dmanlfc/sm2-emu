msgstr "VulkanMemoryAllocator - GPU 메모리 (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - 셰이더 컴파일"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - 박스 아트 이미지 디코딩 (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "게임패드 그림 - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - 아트워크 가져오기 (선택 사항)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - 번역용 텍스트 셰이핑"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
