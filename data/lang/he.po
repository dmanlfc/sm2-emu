#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"in absolute mouse mode (GUN4IR, Sinden, AimTrak) before launching for "
"independent per-player aiming."
msgstr ""
"לא זוהו אקדחי אור ייעודיים. שחקן 1 מכוון בעכבר; הכפתור השמאלי יורה והימני טוען מחדש (ירי מחוץ למסך). חברו אקדחים במצב עכבר מוחלט (GUN4IR, Sinden, AimTrak) לפני ההפעלה לכיוון עצמאי לכל שחקן."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"tagged ID_INPUT_GUN for independent per-player aiming."
msgstr ""
"לא זוהו אקדחי אור ייעודיים. שחקן 1 מכוון בעכבר; הכפתור השמאלי יורה והימני טוען מחדש (ירי מחוץ למסך). חברו אקדחים המסומנים ID_INPUT_GUN לכיוון עצמאי לכל שחקן."

