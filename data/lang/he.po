#: src/osd/gui.cpp
#, no-c-format
msgid "File"
msgstr "קובץ"

#: src/osd/gui.cpp
#, no-c-format
msgid "Hide overlay"
msgstr "הסתרת התפריט"

#: src/osd/gui.cpp
#, no-c-format
msgid "Quit"
msgstr "יציאה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "הגדרות"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "סנכרון אנכי"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "מסך מלא"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "מונה FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "התראות על המסך"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "מצב אקדח אור"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "וידאו"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"המתנה לריענון האנכי לפני ההצגה.\n"
"מונע קריעת תמונה אך מוסיף עד פריים אחד של השהיה."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "התראות"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "אוטומטי (מערכת)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "שפה"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "אוטומטי (הטוב ביותר)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "מרנדר"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "תוכנה"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"איזה מרנדר מצייר את המשחק. חל בהפעלה\n"
"הבאה - שמרו את ההגדרות והפעילו מחדש."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "גודל חלון"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "רוחב"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "גובה"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (מקורי)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "קנה מידה לרינדור 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"רזולוציית רינדור 3D פנימית. גבוה יותר = 3D חד יותר\n"
"(2D/HUD נשאר חד). למנועי GPU בלבד; מרנדר התוכנה\n"
"נשאר ברזולוציה המקורית. חל בהפעלה הבאה - שמרו\n"
"את ההגדרות והפעילו מחדש."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "בילינארי"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "שלם"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "השכן הקרוב"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "בילינארי חד"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "הגדלת 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"כיצד הפריים מוגדל לחלון.\n"
"בילינארי חד שומר על טקסט 2D חד בלי ההבהוב\n"
"של השכן הקרוב בגדלי חלון לא שלמים. שלם נצמד\n"
"לכפולה שלמה (מדויק לפיקסל, עם פסים שחורים).\n"
"חל מיידית."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (ארקייד)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "פיקסלים ריבועיים"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "מתיחה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "יחס תצוגה"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 הוא צורת מסך הארקייד (ברירת המחדל).\n"
"פיקסלים ריבועיים מציג את 496x384 הגולמי (מעט צר).\n"
"מתיחה ממלאת את כל החלון. חל מיידית."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "מסנן CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"מראה קוסמטי של מסך ארקייד על הפריים הסופי:\n"
"קווי סריקה, מסכת צל RGB, זוהר ועקמומיות\n"
"מסך אופציונלית. ויזואלי בלבד; חל מיידית."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "קווי סריקה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "מסכה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "זוהר"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "עקמומיות"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "שיפור (קוסמטי, מעבר לחומרה המקורית)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "אנאיזוטרופי"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "נאמן למקור"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "מסנן טקסטורות 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(לא נתמך)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "ה-GPU הזה לא מדווח על סינון אנאיזוטרופי."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "אנאיזוטרופיה"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "הגדלה חכמה 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"החלקת קצוות בשכבות 2D (HUD, טקסט, תפריטים). xBR\n"
"ו-ScaleFX מעגלים אלכסונים; נאמן למקור שומר על פיקסלים חדים.\n"
"חל מיידית."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "ממוזג"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "דמקה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "שקיפות"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"החומרה מציירת משטחים שקופים (אורות, זכוכית,\n"
"צללים) כדמקה. ממוזג מצייר את המשטח השקוף\n"
"ב-50% שאליו היא מכוונת. חל מיידית."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "טקסטורות מותאמות"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"החלפת טקסטורות ה-3D של המשחק בתמונות השמורות\n"
"ב-saves/textures/<game>/load, בשמות כפי שנשלפו. למרנדרי\n"
"GPU בלבד; טעינה מחדש קולטת קבצים שנערכו."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu נטענו"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "טעינה מחדש"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "שליפת טקסטורות"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"איסוף כל טקסטורת 3D שהמשחק מצייר וכתיבתן,\n"
"עם index.html לעיון, אל saves/textures/<game>/dump\n"
"כשהמשחק נסגר או כשאפשרות זו מכובה."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "שמע"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "נתיבים"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "עיון..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "תיקיית תצורה"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"המקום שממנו sm2-emu.ini נקרא ואליו הוא נשמר.\n"
"נקבע עם --config <dir>; לא ניתן לשנות כאן."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "תיקיית ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"המקום שבו נמצאים ארכיוני ה-ROM. משחק שמופעל לפי שם\n"
"נטען מכאן כ-<name>.zip או <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "תיקיית שמירות"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"שמירות מגובות סוללה: קובצי NVRAM (.nv) ו-EEPROM\n"
"(.eeprom) לכל משחק -- שיאים והגדרות מפעיל."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "תיקיית צילומי מסך"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "המקום שבו נכתבים צילומי המסך של F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "הורדת תמונות מהרשת"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"מאפשר לבורר המשחקים להוריד תמונות עטיפה ותיאורים\n"
"מ-ArcadeDB דרך הרשת. כבוי שומר את sm2-emu לא מקוון:\n"
"הבורר עדיין מציג ומפעיל כל משחק, עם אריחי\n"
"מציין מקום וללא תיאורים."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "בקר"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "הגה"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
msgstr "אקדח אור"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
msgstr "רשת"

#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "מצבים"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "אודות"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "אמולטור ארקייד של Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "רישיון BSD בן 3 סעיפים. ראו LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu קיים בזכות קוד פתוח ששותף עם הקהילה."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "תודה לפרויקטים שהקוד שלהם מאפשר זאת:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "פרויקט MAME - הכוונה לאמולציית Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - ליבת CPU של Motorola 68000 (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - ליבות קול Yamaha FM (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - חלונות, קלט ושמע"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - ממשק המשתמש הזה (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - פענוח games.xml"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - פריסת ארכיוני ZIP"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - פריסת ארכיוני 7-Zip (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - זיכרון GPU (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - הידור שיידרים"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - פענוח תמונות עטיפה (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "תמונת הבקר - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - הורדת תמונות (אופציונלי)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - עיצוב טקסט לתרגומים"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - פריסת טקסט מימין לשמאל (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "תמונות ותיאורי משחקים מ-ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, מאת Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "ראו NOTICE לייחוס מלא לכל רכיב."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "אם תרצו לתמוך בפיתוח:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "שמירת הגדרות"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "נשמר אל %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "הגה מחובר."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "אין הגה מחובר. ההגדרות יחולו כשיחובר."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "משוב כוח"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"כוח הגה במשחקי נהיגה: כוחות מירכוז ופנייה\n"
"שמפוענחים מפקודות לוח ההנעה של המשחק עצמו,\n"
"וכן טלטלה בעת פגיעה במשהו."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "התנגדות"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "היפוך משוב כוח"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"להגה שהדרייבר שלו דוחף לכיוון הלא נכון: הוא מושך\n"
"הרחק מהמרכז במקום להחזיר אליו, וכוחות\n"
"המשחק פועלים בכיוון ההפוך."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "רטט"

