#, no-c-format
msgid "Lock angle"
msgstr "Uhol natočenia"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d st."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Ako ďaleko fyzicky otočiť pre plné natočenie v hre\n"
"(spolu, teda polovica na každú stranu). Menej = citlivejšie."

#: src/osd/gui.cpp
#, no-c-format
msgid "Centre deadzone"
msgstr "Mŕtva zóna stredu"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel travel about centre that reads as centre. Most wheels\n"
