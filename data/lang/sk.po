#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Pred zobrazením čaká na vertikálne zatemnenie.\n"
"Zabraňuje trhaniu obrazu, ale pridá až jednu snímku oneskorenia."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Oznámenia"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (najlepší)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Softvérový"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Ktorý renderer vykresľuje hru. Prejaví sa pri ďalšom\n"
"spustení - uložte nastavenia a spustite znova."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Veľkosť okna"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Šírka"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Výška"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (natívne)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Mierka 3D vykresľovania"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Vnútorné rozlíšenie 3D vykresľovania. Vyššie dáva ostrejšie\n"
"3D (2D/HUD zostáva ostré). Len GPU renderery; softvérový\n"
"renderer zostáva natívny. Prejaví sa pri ďalšom spustení\n"
"- uložte nastavenia a spustite znova."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineárne"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Celočíselné"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Najbližší"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Ostré bilineárne"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Škálovanie 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Ako sa snímka zväčšuje do okna. Ostré bilineárne drží\n"
"2D text ostrý bez mihotania, ktoré má najbližší pri\n"
"neceločíselnej veľkosti okna. Celočíselné prichytí\n"
"k celému násobku (presne na pixel, s čiernymi pruhmi).\n"
"Prejaví sa hneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "16:9 (widescreen)"
msgstr "16:9 (širokouhlý)"

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (automat)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Štvorcové pixely"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Roztiahnuť"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Pomer strán"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"16:9 (experimental) draws the 3D wider, with the 2D in the middle.\n"
"Stretch fills the whole window.\n"
"GPU renderers only. Applies live."
msgstr ""
"4:3 je tvar arkádového monitora (predvolené).\n"
"Štvorcové pixely zobrazia surové 496x384 (mierne úzke).\n"
"16:9 (experimentálne) kreslí 3D širšie, s 2D v strede.\n"
"Roztiahnuť vyplní celé okno.\n"
"Len GPU renderery. Platí okamžite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Brightness"
msgstr "Jas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 2 picture's black sits. 50% is the default,\n"
"matched to an arcade capture; lower is darker, higher is\n"
"brighter. Applies live."
msgstr ""
"Kde leží čierna v obraze Model 2. 50 % je predvolené,\n"
"podľa záznamu z automatu; menej je tmavšie, viac je svetlejšie.\n"
"Prejaví sa hneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filter CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Kozmetický vzhľad monitora automatu cez hotovú snímku:\n"
"riadkovanie, RGB maska, žiara a voliteľné zakrivenie\n"
"obrazovky. Čisto vizuálne; prejaví sa hneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Riadkovanie"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maska"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Žiara"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Zakrivenie"

#: src/osd/gui.cpp
#, no-c-format
msgid "Bezel"
msgstr "Rámik"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"In fullscreen, frame the 4:3 picture with an image from\n"
"the bezels directory (Paths tab): <game>.png, the parent\n"
"set's, or default.png. The picture fills the image's\n"
"transparent window."
msgstr ""
"Na celej obrazovke orámuje obraz 4:3 obrázkom z\n"
"priečinka rámikov (karta Cesty): <game>.png, obrázkom\n"
"rodičovskej sady alebo default.png. Obraz vyplní\n"
"priehľadné okno obrázka."

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Vylepšenia (kozmetické, nad rámec pôvodného hardvéru)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anizotropné"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Verné"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filter 3D textúr"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(nepodporované)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Toto GPU nehlási anizotropné filtrovanie."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anizotropia"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Zväčšenie 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Vyhladzuje hrany 2D vrstiev (HUD, text, ponuky). xBR a\n"
"ScaleFX zaobľujú uhlopriečky; Verné drží ostré pixely.\n"
"Prejaví sa hneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Prelínané"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Šachovnica"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Priehľadnosť"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Hardvér kreslí priehľadné plochy (svetlá, sklo, tiene)\n"
"ako šachovnicu. Prelínané kreslí 50% priehľadnú\n"
"plochu, o ktorú sa snaží. Prejaví sa hneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "Extended draw distance"
msgstr "Rozšírená vzdialenosť vykresľovania"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw the scenery to the edge of the course instead of\n"
"the arcade's short range, so it no longer pops in.\n"
"Daytona USA only. Applies live."
msgstr ""
"Vykresľuje scenériu až k okraju trate namiesto\n"
"krátkeho dosahu automatu, takže už nevyskakuje.\n"
"Len Daytona USA. Prejaví sa ihneď."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Vlastné textúry"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Nahradí 3D textúry hry obrázkami uloženými v\n"
"saves/textures/<game>/load, pomenovanými ako pri výpise.\n"
"Len GPU renderery; Znova načítať prevezme upravené súbory."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "Načítané: %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Znova načítať"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Vypísať textúry"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Zbiera každú 3D textúru, ktorú hra kreslí, a zapíše ich\n"
"s index.html na prehliadanie do saves/textures/<game>/dump\n"
"po ukončení hry alebo vypnutí tejto voľby."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Zvuk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Cesty"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Prehľadávať..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Priečinok konfigurácie"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where keisho.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Odkiaľ sa keisho.ini načítava a kam sa ukladá.\n"
"Nastavuje sa cez --config <dir>; tu sa nedá zmeniť."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Priečinok ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Kde sú archívy ROM. Hra spustená podľa názvu sa\n"
"načíta odtiaľto ako <name>.zip alebo <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Model 1 ROM directory"
msgstr "Priečinok ROM pre Model 1"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 1 ROM archives live.\n"
"Empty means the ROM directory."
msgstr ""
"Kde sú archívy ROM pre Model 1.\n"
"Prázdne znamená priečinok ROM."

#: src/osd/gui.cpp
#, no-c-format
msgid "Model 3 ROM directory"
msgstr "Priečinok ROM pre Model 3"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 3 ROM archives live.\n"
"Empty means the ROM directory."
msgstr ""
"Kde sú archívy ROM pre Model 3.\n"
"Prázdne znamená priečinok ROM."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Priečinok uložení"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Batériovo zálohované dáta: obrazy NVRAM (.nv) a EEPROM\n"
"(.eeprom) pre každú hru -- rekordy a nastavenia operátora."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Priečinok snímok obrazovky"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where screenshots are written."
msgstr "Kam sa ukladajú snímky obrazovky."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bezels directory"
msgstr "Priečinok rámikov"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Bezel images: <game>.png, the parent set's, or default.png.\n"
"Empty means a bezels folder beside keisho.ini."
msgstr ""
"Obrázky rámikov: <game>.png, rodičovskej sady alebo default.png.\n"
"Prázdne znamená priečinok bezels vedľa keisho.ini."

#: src/osd/gui.cpp
#, no-c-format
msgid "Crosshairs directory"
msgstr "Priečinok zameriavačov"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Crosshair images: <game>-p1.png (-p2 for player 2) or\n"
"<game>.png for both, then the parent set's, then default.\n"
"Drawn at their own size on a 1080-line picture. Without\n"
"one the built-in crosshair is drawn.\n"
"Empty means a crosshairs folder beside keisho.ini."
msgstr ""
"Obrázky zameriavačov: <game>-p1.png (-p2 pre hráča 2) alebo\n"
"<game>.png pre oboch, potom rodičovskej sady, potom default.\n"
"Kreslia sa vo vlastnej veľkosti na obraz s 1080 riadkami. Bez\n"
