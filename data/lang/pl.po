msgstr "Przewiń do przodu (przytrzymaj)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Rewind (held)"
msgstr "Przewiń wstecz (przytrzymaj)"

#: src/osd/gui.cpp
#, no-c-format
msgid "press a key..."
msgstr "naciśnij klawisz..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Clear"
msgstr "Wyczyść"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Click a key, then press the new one. Escape cancels.\n"
"A key a game also uses does both."
msgstr ""
"Kliknij klawisz, potem naciśnij nowy. Escape anuluje.\n"
"Klawisz używany też przez grę robi jedno i drugie."

#: src/osd/gui.cpp
#, no-c-format
msgid "Load a game to save and restore its state."
msgstr "Wczytaj grę, aby zapisywać i przywracać jej stan."

#: src/osd/gui.cpp
#, c-format
msgid ""
"Save the whole machine to a slot and restore it later. Quick-save is %s, "
"quick-load is %s."
msgstr ""
"Zapisz całą maszynę do slotu i przywróć ją później. Szybki zapis to %s, "
"szybkie wczytanie to %s."

#: src/osd/gui.cpp
#, no-c-format
