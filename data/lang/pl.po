msgstr "Usuń"

#: src/osd/gui.cpp
#, no-c-format
msgid "Load"
msgstr "Wczytaj"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save"
msgstr "Zapisz"

#: src/osd/gui.cpp
#, no-c-format
msgid "empty"
msgstr "pusty"

#: src/osd/gui.cpp
#, no-c-format
msgid "Could not start the game"
msgstr "Nie można uruchomić gry"

#: src/osd/gui.cpp
#, no-c-format
