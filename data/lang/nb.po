msgstr "stb_image - dekoding av omslagsbilder (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr ""
"Kontrollerbilde - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - henting av omslagsbilder (valgfritt)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - tekstforming for oversettelser"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - tekstoppsett fra høyre mot venstre (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Spillbilder og beskrivelser fra ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, av Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Se NOTICE for fullstendig kreditering per komponent."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Hvis du vil støtte utviklingen:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Lagre innstillinger"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Lagret til %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Ratt tilkoblet."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Ingen ratt tilkoblet. Innstillingene gjelder når et kobles til."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Rattkraft i bilspill: sentrerings- og svingkrefter\n"
"dekodet fra spillets egne drivkortkommandoer,\n"
"pluss et støt når du treffer noe."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Motstand"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Inverter force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"For et ratt der driveren skyver feil vei: det trekker\n"
"bort fra midten i stedet for å føre det tilbake,\n"
"og spillets krefter går motsatt vei."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibrasjon"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrerer ved spillets sammenstøt, for ratt uten force\n"
"feedback. Kjører aldri samtidig med force feedback."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Vibrasjonsstyrke"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Motorvibrasjon"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"En ekstra vibrasjon som øker med gasspådraget. Den kommer\n"
"ikke fra spillet. Slå av for bare å kjenne spillets force feedback."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u grader"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Rattutslag"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Sett dette til rattets eget dreieområde. Låsevinkelen\n"
"nedenfor tilordnes dette, så et samsvarende ratt gir\n"
"arkadeaktig respons."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Låsevinkel"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d grader"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Hvor langt du fysisk dreier for fullt utslag i spillet\n"
"(totalt, altså halvparten til hver side). Lavere er mer følsomt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Akser"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr ""
"Oppdaget automatisk. Kalibrer på nytt hvis styring eller en pedal er feil."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Styring"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Gasspedal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Brake"
msgstr "Brems"

#: src/osd/gui.cpp
#, no-c-format
msgid "auto"
msgstr "auto"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d (inverted)"
msgstr "akse %d (invertert)"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d"
msgstr "akse %d"

#: src/osd/gui.cpp
#, no-c-format
msgid "operate it..."
msgstr "bruk den..."

#: src/osd/gui.cpp
#, no-c-format
msgid "cancel"
msgstr "avbryt"

#: src/osd/gui.cpp
#, no-c-format
msgid "Calibrate"
msgstr "Kalibrer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Buttons"
msgstr "Knapper"

#: src/osd/gui.cpp
#, no-c-format
msgid "Press Bind, then press the wheel button for that control."
msgstr "Trykk Tilordne, og trykk deretter rattknappen for den funksjonen."

#: src/osd/gui.cpp
