#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Vent på vertikal blanking før visning.\n"
"Hindrer tearing, men gir opptil ett bildes forsinkelse."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Varsler"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatisk (system)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Språk"

#: src/osd/gui.cpp
#, no-c-format
