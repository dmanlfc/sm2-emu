#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Show the aiming crosshair and hide the mouse cursor,\n"
"for the light-gun titles (Virtua Cop 2, House of the\n"
"Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)."
msgstr ""
"Vis siktet og skjul musepekeren for\n"
"lyspistolspillene (Virtua Cop 2, House of the\n"
"Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)."

#: src/osd/gui.cpp
#, no-c-format
msgid "Show crosshair"
msgstr "Vis sikte"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw sm2-emu's own crosshair. Turn off if the gun\n"
"has its own sight (e.g. a Sinden). Positional-gun\n"
"titles always draw their own regardless."
msgstr ""
"Tegn sm2-emus eget sikte. Slå av hvis pistolen\n"
"har sitt eget sikte (f.eks. en Sinden). Spill med\n"
"posisjonspistol tegner alltid sitt eget uansett."

#: src/osd/gui.cpp
#, no-c-format
msgid "Hide shot flash"
msgstr "Skjul skuddblink"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Hide the white flash Virtua Cop, Virtua Cop 2 and\n"
"House of the Dead show on each shot."
msgstr ""
"Skjul det hvite blinket Virtua Cop, Virtua Cop 2 og\n"
"House of the Dead viser ved hvert skudd."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Player 1 aims with the mouse; the left button fires and the right button "
"reloads (shoot off screen)."
msgstr ""
"Spiller 1 sikter med musen; venstre knapp skyter og høyre knapp lader om (skyt utenfor skjermen)."

#: src/osd/gui.cpp
#, no-c-format
msgid "Recoil"
msgstr "Rekyl"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Kick the gun's rumble motor on each shot, for guns\n"
"that have one (Sinden and similar). No effect on a\n"
"gun without a motor."
msgstr ""
"Gi pistolens vibrasjonsmotor et støt ved hvert skudd, for\n"
"pistoler som har en (Sinden og lignende). Ingen effekt\n"
"på en pistol uten motor."

#: src/osd/gui.cpp
#, no-c-format
msgid "Enable recoil"
msgstr "Aktiver rekyl"

#: src/osd/gui.cpp
#, no-c-format
msgid "Strength"
msgstr "Styrke"

#: src/osd/gui.cpp
#, no-c-format
msgid "Devices"
msgstr "Enheter"

#: src/osd/gui.cpp
#, c-format
msgid "Gun %zu (player %zu): %s"
msgstr "Pistol %zu (spiller %zu): %s"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"in absolute mouse mode (GUN4IR, Sinden, AimTrak) before launching for "
"independent per-player aiming."
msgstr ""
"Ingen dedikerte lyspistoler funnet. Spiller 1 sikter med musen; venstre knapp skyter og høyre knapp lader om (skyt utenfor skjermen). Koble til pistoler i absolutt musemodus (GUN4IR, Sinden, AimTrak) før oppstart for uavhengig sikting per spiller."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"tagged ID_INPUT_GUN for independent per-player aiming."
msgstr ""
"Ingen dedikerte lyspistoler funnet. Spiller 1 sikter med musen; venstre knapp skyter og høyre knapp lader om (skyt utenfor skjermen). Koble til pistoler merket ID_INPUT_GUN for uavhengig sikting per spiller."

