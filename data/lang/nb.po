msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (best)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programvare"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Hvilken renderer som tegner spillet. Gjelder ved\n"
"neste oppstart - lagre innstillingene og start på nytt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Vindusstørrelse"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Bredde"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Høyde"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D-gjengivelsesskala"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Intern 3D-oppløsning. Høyere gir skarpere 3D\n"
"(2D/HUD forblir skarpt). Kun GPU-backends; program-\n"
"varerendereren forblir original. Gjelder ved neste\n"
"oppstart - lagre innstillingene og start på nytt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineær"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Heltall"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Nærmeste"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Skarp bilineær"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D-skalering"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Hvordan bildet forstørres til vinduet.\n"
"Skarp bilineær holder 2D-tekst skarp uten flimringen\n"
"nærmeste gir ved vindusstørrelser som ikke er heltall. Heltall\n"
"låser til et helt multiplum (pikselperfekt, med svarte felt).\n"
"Gjelder umiddelbart."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratiske piksler"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Strekk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Sideforhold"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 er arkademonitorens form (standard).\n"
"Kvadratiske piksler viser rå 496x384 (litt smalt).\n"
"Strekk fyller hele vinduet. Gjelder umiddelbart."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT-filter"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Et kosmetisk arkademonitor-utseende over det ferdige bildet:\n"
"skannelinjer, en RGB-skyggemaske, glød og valgfri skjerm-\n"
"krumming. Rent visuelt; gjelder umiddelbart."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Skannelinjer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maske"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Glød"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Krumming"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Forbedring (kosmetisk, utover den originale maskinvaren)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotropisk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Tro mot originalen"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D-teksturfilter"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(ikke støttet)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Denne GPU-en rapporterer ikke anisotropisk filtrering."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropi"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D-oppskalering"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Glatt ut kantene på 2D-lagene (HUD, tekst, menyer). xBR\n"
"og ScaleFX runder av diagonaler; Tro mot originalen\n"
"beholder skarpe piksler. Gjelder umiddelbart."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Blandet"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Raster"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Gjennomsiktighet"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Maskinvaren tegner gjennomsiktige flater (lys, glass,\n"
"skygger) som et sjakkbrettmønster. Blandet tegner den\n"
"50% gjennomsiktige flaten som er tiltenkt. Gjelder umiddelbart."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Egne teksturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Erstatt spillets 3D-teksturer med bilder lagret i\n"
"saves/textures/<game>/load, navngitt som dumpet.\n"
"Kun GPU-renderere; Last inn på nytt henter endrede filer."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu lastet"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Last inn på nytt"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Dump teksturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Samle alle 3D-teksturer spillet tegner og skriv dem,\n"
"med en index.html for å bla, til saves/textures/<game>/dump\n"
"når spillet avsluttes eller dette slås av."

