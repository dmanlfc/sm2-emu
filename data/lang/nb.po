#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Konfigurasjonsmappe"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Hvor sm2-emu.ini leses fra og lagres til.\n"
"Angis med --config <dir>; kan ikke endres her."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "ROM-mappe"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Hvor ROM-arkivene ligger. Et spill startet med navn\n"
"lastes herfra som <name>.zip eller <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mappe for lagringer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Batteribaserte lagringer: NVRAM- (.nv) og EEPROM-\n"
"(.eeprom) bilder per spill -- poengrekorder og operatørinnstillinger."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mappe for skjermbilder"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Hvor F12-skjermbilder lagres."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Hent omslagsbilder på nett"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"La spillvelgeren hente omslagsbilder og beskrivelser fra\n"
"ArcadeDB over nettverket. Av holder sm2-emu frakoblet: velgeren\n"
"viser og starter fortsatt alle spill, med plassholder-\n"
"fliser og uten beskrivelser."

