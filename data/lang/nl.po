#: src/osd/gui.cpp
#, no-c-format
msgid ""
"This machine's address on the cabinet LAN. Blank\n"
"listens on every interface. Detect fills it from the\n"
"primary network adapter."
msgstr ""
"Het adres van deze machine op het kast-LAN. Leeg\n"
"luistert op elke interface. Detecteren vult het in vanaf\n"
"de primaire netwerkadapter."

