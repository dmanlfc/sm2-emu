msgid "Quit"
msgstr "Salir"

#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "Ajustes"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Pantalla completa"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "Contador de FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "Notificaciones en pantalla"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "Modo pistola"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Vídeo"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Espera al borrado vertical antes de mostrar la imagen.\n"
"Evita el tearing, pero añade hasta un fotograma de retardo."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notificaciones"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automático (sistema)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Idioma"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (el mejor)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderizador"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Software"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Qué renderizador dibuja el juego. Se aplica en el\n"
"próximo inicio: guarda los ajustes y reinicia."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Tamaño de ventana"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Ancho"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Alto"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (nativo)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Escala de render 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Resolución interna del render 3D. Más alta, 3D más nítido\n"
"(el 2D/HUD sigue nítido). Solo con GPU; el renderizador\n"
"software sigue nativo. Se aplica en el próximo inicio:\n"
"guarda los ajustes y reinicia."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Entero"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Vecino más cercano"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Bilineal nítido"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Escalado 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Cómo se amplía la imagen a la ventana.\n"
"Bilineal nítido mantiene el texto 2D nítido sin el parpadeo\n"
"del vecino más cercano en tamaños no enteros. Entero ajusta\n"
"a un múltiplo exacto (pixel perfect, con bandas negras).\n"
"Se aplica al instante."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Píxeles cuadrados"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Estirar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Aspecto"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 es la forma del monitor arcade (por defecto).\n"
"Píxeles cuadrados muestra los 496x384 sin más (algo estrecho).\n"
"Estirar llena toda la ventana. Se aplica al instante."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filtro CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Un aspecto de monitor arcade sobre la imagen final:\n"
"scanlines, máscara de sombra RGB, resplandor y curvatura\n"
"opcional. Solo visual; se aplica al instante."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanlines"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Máscara"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Resplandor"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Curvatura"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Mejora (estética, más allá del hardware original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotrópico"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Fiel"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filtro de texturas 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(no compatible)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Esta GPU no indica soporte de filtrado anisotrópico."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropía"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Escalado 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Suaviza los bordes de las capas 2D (HUD, texto, menús). xBR\n"
"y ScaleFX redondean diagonales; Fiel mantiene los píxeles.\n"
"Se aplica al instante."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Mezclado"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Trama"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Transparencia"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"El hardware dibuja las superficies transparentes (luces,\n"
"cristales, sombras) como un tablero de ajedrez. Mezclado\n"
"dibuja la transparencia al 50% que se busca. Al instante."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Texturas personalizadas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Sustituye las texturas 3D del juego por imágenes guardadas\n"
"en saves/textures/<game>/load, con el nombre del volcado.\n"
"Solo con GPU; Recargar lee los archivos editados."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu cargadas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Recargar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Volcar texturas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Recoge cada textura 3D que dibuja el juego y las guarda,\n"
"con un index.html para verlas, en saves/textures/<game>/dump\n"
"al salir del juego o al desactivar esta opción."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Audio"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Rutas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Examinar..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Carpeta de configuración"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Desde donde se lee y guarda sm2-emu.ini.\n"
"Se fija con --config <dir>; no se puede cambiar aquí."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Carpeta de ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Donde están los archivos de ROM. Un juego iniciado por nombre\n"
"se carga desde aquí como <name>.zip o <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Carpeta de partidas guardadas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Guardado con batería: imágenes NVRAM (.nv) y EEPROM\n"
"(.eeprom) por juego -- récords y ajustes del operador."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Carpeta de capturas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Donde se guardan las capturas de F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Descargar carátulas en línea"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Permite que el selector descargue carátulas y descripciones\n"
"de ArcadeDB por la red. Desactivado, sm2-emu no usa la red:\n"
"el selector sigue listando e iniciando todos los juegos, con\n"
"imágenes genéricas y sin descripciones."

