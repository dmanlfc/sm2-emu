#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "Stāvokļi"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "Par"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "Sega Model 2 arkādes automātu emulators"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "BSD 3-Clause licence. Skatīt LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu pastāv, pateicoties atvērtajam kodam, ar ko dalās kopiena."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "Paldies projektiem, kuru kods to padara iespējamu:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "MAME projekts - Sega Model 2 emulācijas vadlīnijas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - Motorola 68000 CPU kodols (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - Yamaha FM skaņas kodoli (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - logi, ievade un audio"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - šī lietotāja saskarne (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - games.xml parsēšana"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - ZIP arhīvu atspiešana"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - 7-Zip arhīvu atspiešana (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - GPU atmiņa (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - ēnotāju kompilēšana"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - vāku attēlu dekodēšana (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "Spēļu pults attēls - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - attēlu lejupielāde (pēc izvēles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - teksta veidošana tulkojumiem"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - teksta izkārtojums no labās uz kreiso (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Spēļu attēli un apraksti no ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, autors Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Pilnu katra komponenta autortiesību informāciju skatīt NOTICE."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Ja vēlaties atbalstīt izstrādi:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Saglabāt iestatījumus"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Saglabāts: %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Stūre pievienota."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Stūre nav pievienota. Iestatījumi stāsies spēkā, kad tā būs."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Spēka atgriezeniskā saite"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Stūres spēks braukšanas spēlēs: centrēšanas un pagriezienu\n"
"spēki, atšifrēti no spēles stūres vadības plates komandām,\n"
"kā arī trieciena grūdiens, kad kaut kam ietriecaties."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Pretestība"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Invertēt spēka atgriezenisko saiti"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"Stūrei, kuras draiveris spiež nepareizā virzienā: tā velk\n"
"prom no centra, nevis atgriež to, un spēles spēki\n"
"darbojas pretējā virzienā."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibrācija"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrē spēles triecienos - stūrēm bez spēka atgriezeniskās\n"
"saites. Nekad nedarbojas kopā ar spēka atgriezenisko saiti."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Vibrācijas stiprums"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Dzinēja vibrācija"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"Papildu vibrācija, kas pieaug līdz ar gāzi. Tā nav\n"
"no spēles. Izslēdziet, lai just tikai spēles spēka atgriezenisko saiti."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u°"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Stūrēšanas diapazons"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Iestatiet sava stūres rata griešanās diapazonu. Zemāk\n"
"esošais bloķēšanas leņķis tiek attēlots uz to, tāpēc\n"
"atbilstība jūsu stūrei dod arkādei līdzīgu reakciju."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Bloķēšanas leņķis"

