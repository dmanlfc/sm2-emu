#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Pilnekrāns"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "FPS skaitītājs"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "Paziņojumi ekrānā"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "Gaismas pistoles režīms"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Video"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Pirms attēlošanas gaidīt vertikālo atgriezi.\n"
"Novērš plīšanu, bet pievieno līdz viena kadra aizturi."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Paziņojumi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automātiski (sistēma)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Valoda"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Automātiski (labākais)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderētājs"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programmatūras"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Kurš renderētājs zīmē spēli. Stājas spēkā nākamajā\n"
"palaišanā - saglabājiet iestatījumus un palaidiet no jauna."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Loga izmērs"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Platums"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Augstums"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (oriģinālais)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D renderēšanas mērogs"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Iekšējā 3D renderēšanas izšķirtspēja. Augstāka - asāks 3D\n"
"(2D/HUD paliek ass). Tikai GPU renderētājiem; programmatūras\n"
"renderētājs paliek oriģinālais. Stājas spēkā nākamajā palaišanā -\n"
"saglabājiet iestatījumus un palaidiet no jauna."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineārs"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Vesels skaitlis"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Tuvākais"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Ass bilineārs"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D mērogošana"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Kā kadrs tiek palielināts līdz logam.\n"
"Ass bilineārs saglabā 2D tekstu asu bez mirgošanas,\n"
"ko „tuvākais” rāda ne-veselu loga izmēru gadījumā.\n"
"„Vesels skaitlis” pielāgo veselam daudzkārtnim\n"
"(pikseļprecīzi, ar melnām joslām). Stājas spēkā uzreiz."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkādes)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadrātveida pikseļi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Izstiept"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Malu attiecība"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 ir arkādes monitora forma (noklusējums).\n"
"Kvadrātveida pikseļi rāda neapstrādātu 496x384 (nedaudz šauru).\n"
"„Izstiept” aizpilda visu logu. Stājas spēkā uzreiz."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT filtrs"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Kosmētisks arkādes monitora izskats pāri gatavajam kadram:\n"
"skenēšanas līnijas, RGB ēnu maska, mirdzums un pēc izvēles\n"
"ekrāna izliekums. Tikai vizuāls; stājas spēkā uzreiz."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Skenēšanas līnijas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maska"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Mirdzums"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Izliekums"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Uzlabojumi (kosmētiski, pāri oriģinālajai aparatūrai)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anizotropais"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Oriģināls"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D tekstūru filtrs"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(netiek atbalstīts)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Šis GPU neziņo par anizotropo filtrēšanu."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anizotropija"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D palielināšana"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Nogludināt 2D slāņu malas (HUD, teksts, izvēlnes). xBR un\n"
"ScaleFX noapaļo diagonāles; „Oriģināls” saglabā asus\n"
"pikseļus. Stājas spēkā uzreiz."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Sapludināts"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Punktots"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Caurspīdīgums"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Aparatūra zīmē caurspīdīgas virsmas (gaismas, stiklu,\n"
"ēnas) kā šaha galdiņu. „Sapludināts” zīmē 50%\n"
"caurspīdīgu virsmu, ko tā cenšas panākt. Stājas spēkā uzreiz."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Pielāgotas tekstūras"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Aizstāt spēles 3D tekstūras ar attēliem, kas saglabāti\n"
"saves/textures/<game>/load, nosauktiem kā izgūtie. Tikai\n"
"GPU renderētāji; „Pārlādēt” ielasa rediģētos failus."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "Ielādētas: %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Pārlādēt"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Izgūt tekstūras"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Savākt visas spēles zīmētās 3D tekstūras un ierakstīt tās\n"
"ar pārlūkošanai paredzētu index.html mapē saves/textures/<game>/dump,\n"
"kad spēle beidzas vai šī opcija tiek izslēgta."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Audio"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Ceļi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Pārlūkot..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Konfigurācijas mape"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"No kurienes sm2-emu.ini tiek nolasīts un kur saglabāts.\n"
"Iestata ar --config <dir>; šeit mainīt nevar."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "ROM mape"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Kur atrodas ROM arhīvi. Pēc nosaukuma palaista spēle\n"
"tiek ielādēta no šejienes kā <name>.zip vai <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Saglabājumu mape"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Ar bateriju uzturēti saglabājumi: katras spēles NVRAM (.nv) un\n"
"EEPROM (.eeprom) attēli -- rekordi un operatora iestatījumi."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Ekrānuzņēmumu mape"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Kur tiek ierakstīti F12 ekrānuzņēmumi."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Lejupielādēt attēlus tiešsaistē"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Ļaut spēļu izvēlnei ielādēt vāku attēlus un aprakstus no\n"
"ArcadeDB caur tīklu. Izslēgts saglabā sm2-emu bezsaistē:\n"
"izvēlne joprojām parāda un palaiž visas spēles, ar\n"
"aizvietotāju flīzēm un bez aprakstiem."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "Spēļu pults"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "Stūre"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
msgstr "Gaismas pistole"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
