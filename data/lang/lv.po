#, no-c-format
msgid ""
"Player 1 aims with the mouse; the left button fires and the right button "
"reloads (shoot off screen)."
msgstr "1. spēlētājs tēmē ar peli; kreisā poga šauj, labā pārlādē (šaujiet ārpus ekrāna)."

