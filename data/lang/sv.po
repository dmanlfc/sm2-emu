msgstr "Sökvägar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Bläddra..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Konfigurationsmapp"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Där sm2-emu.ini läses från och sparas till.\n"
"Anges med --config <dir>; kan inte ändras här."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "ROM-mapp"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Där ROM-arkiven finns. Ett spel som startas med namn\n"
"laddas härifrån som <name>.zip eller <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mapp för sparfiler"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Batterisparade data: NVRAM- (.nv) och EEPROM-\n"
"(.eeprom) avbilder per spel -- topplistor och operatörsinställningar."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mapp för skärmbilder"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Där F12-skärmbilder sparas."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Hämta omslagsbilder online"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Låt spelväljaren hämta omslagsbilder och beskrivningar från\n"
"ArcadeDB via nätverket. Av håller sm2-emu offline: väljaren\n"
"listar och startar fortfarande alla spel, med platshållar-\n"
"rutor och utan beskrivningar."

