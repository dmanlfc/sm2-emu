msgstr "stb_image - avkodning av omslagsbilder (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr ""
"Handkontrollsbild - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - hämtning av omslagsbilder (valfritt)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - textformning för översättningar"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - textlayout från höger till vänster (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Spelbilder och beskrivningar från ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, av Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Se NOTICE för fullständig tillskrivning per komponent."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Om du vill stödja utvecklingen:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Spara inställningar"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Sparat till %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Ratt ansluten."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Ingen ratt ansluten. Inställningarna gäller när en ansluts."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Rattkraft i bilspel: centrerings- och kurvkrafter\n"
"avkodade från spelets egna drivkortskommandon,\n"
"plus en stöt när du krockar."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Motstånd"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Invertera force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"För en ratt vars drivrutin trycker åt fel håll: den drar\n"
"bort från mitten i stället för att föra tillbaka den,\n"
"och spelets krafter går åt motsatt håll."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibration"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrerar vid spelets krockar, för rattar utan force\n"
"feedback. Körs aldrig samtidigt med force feedback."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Vibrationsstyrka"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Motorvibration"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"En extra vibration som ökar med gasen. Den kommer inte\n"
"från spelet. Stäng av för att bara känna spelets force feedback."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u grader"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Rattens vridområde"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Ställ in detta på rattens eget vridområde. Utslags-\n"
"vinkeln nedan mappas på det, så rätt värde ger\n"
"arkadlik respons."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Utslagsvinkel"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d grader"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Hur långt du vrider fysiskt för fullt utslag i spelet\n"
"(totalt, så hälften åt varje håll). Lägre är känsligare."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Axlar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr ""
"Identifierade automatiskt. Kalibrera om styrning eller en pedal är fel."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Styrning"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Gaspedal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Brake"
msgstr "Broms"

#: src/osd/gui.cpp
#, no-c-format
msgid "auto"
msgstr "auto"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d (inverted)"
msgstr "axel %d (inverterad)"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d"
msgstr "axel %d"

