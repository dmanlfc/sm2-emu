#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw sm2-emu's own crosshair. Turn off if the gun\n"
"has its own sight (e.g. a Sinden). Positional-gun\n"
"titles always draw their own regardless."
msgstr ""
"Rita sm2-emus eget sikte. Stäng av om pistolen\n"
"har ett eget sikte (t.ex. en Sinden). Spel med\n"
"positionspistol ritar alltid sitt eget ändå."

#: src/osd/gui.cpp
#, no-c-format
msgid "Hide shot flash"
msgstr "Dölj skottblixt"

#: src/osd/gui.cpp
#, no-c-format
