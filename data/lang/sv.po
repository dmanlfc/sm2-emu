#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Vänta på vertikal släckning innan bilden visas.\n"
"Förhindrar tearing men ger upp till en bildrutas fördröjning."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Aviseringar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatiskt (system)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Språk"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (bäst)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderare"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programvara"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Vilken renderare som ritar spelet. Gäller vid\n"
"nästa start - spara inställningarna och starta om."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Fönsterstorlek"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Bredd"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Höjd"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D-renderingsskala"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Intern 3D-upplösning. Högre ger skarpare 3D\n"
"(2D/HUD förblir skarpt). Endast GPU-backends; program-\n"
"varurenderaren förblir original. Gäller vid nästa start -\n"
"spara inställningarna och starta om."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinjär"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Heltal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Närmaste"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Skarp bilinjär"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D-skalning"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Hur bilden förstoras till fönstret.\n"
"Skarp bilinjär håller 2D-text skarp utan flimret som\n"
"närmaste ger vid icke-heltaliga fönsterstorlekar. Heltal\n"
"låser till en hel multipel (pixelperfekt, med svarta kanter).\n"
"Gäller direkt."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkad)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratiska pixlar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Sträck ut"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Bildformat"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 är arkadmonitorns form (standard).\n"
"Kvadratiska pixlar visar råa 496x384 (något smalt).\n"
"Sträck ut fyller hela fönstret. Gäller direkt."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT-filter"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"En kosmetisk arkadmonitor-look över den färdiga bilden:\n"
"scanlines, en RGB-skuggmask, glöd och valfri skärm-\n"
"krökning. Rent visuellt; gäller direkt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanlines"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Mask"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Glöd"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Krökning"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Förbättring (kosmetisk, utöver originalhårdvaran)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotropisk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Trogen"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D-texturfilter"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(stöds inte)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Denna GPU rapporterar ingen anisotropisk filtrering."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropi"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D-uppskalning"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Jämna ut kanterna på 2D-lagren (HUD, text, menyer). xBR\n"
"och ScaleFX rundar diagonaler; Trogen behåller skarpa\n"
"pixlar. Gäller direkt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Blandad"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Raster"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Genomskinlighet"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Hårdvaran ritar genomskinliga ytor (ljus, glas,\n"
"skuggor) som ett schackrutemönster. Blandad ritar den\n"
"50% genomskinliga yta som avses. Gäller direkt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Egna texturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Ersätt spelets 3D-texturer med bilder sparade i\n"
"saves/textures/<game>/load, namngivna som dumpade.\n"
"Endast GPU-renderare; Ladda om läser in ändrade filer."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu laddade"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Ladda om"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Dumpa texturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Samla varje 3D-textur som spelet ritar och skriv dem,\n"
"med en index.html att bläddra i, till saves/textures/<game>/dump\n"
"när spelet avslutas eller detta stängs av."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Ljud"

#: src/osd/gui.cpp
#, no-c-format
