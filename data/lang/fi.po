msgstr "Dear ImGui - tämä käyttöliittymä (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - games.xml:n jäsentäminen"

#: src/osd/gui.cpp
#, no-c-format
