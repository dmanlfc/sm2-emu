msgstr "miniz - ZIP-arkistojen purku"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - 7-Zip-arkistojen purku (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - GPU-muisti (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - varjostimien käännös"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - kansikuvien dekoodaus (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr ""
"Peliohjaimen kuva - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - kansikuvien haku (valinnainen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - tekstin muotoilu käännöksiä varten"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr ""
"SheenBidi - oikealta vasemmalle -tekstin asettelu (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Pelien kuvat ja kuvaukset: ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, tekijä Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
