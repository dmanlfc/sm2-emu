#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
msgstr "الشبكة"

#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "الحالات"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "حول"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "محاكي آركيد لـ Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "رخصة BSD ذات البنود الثلاثة. انظر LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "يوجد sm2-emu بفضل المصادر المفتوحة المشتركة مع المجتمع."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "مع الشكر للمشاريع التي تجعل شيفرتها ذلك ممكنًا:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "مشروع MAME - إرشادات محاكاة Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - نواة معالج Motorola 68000 (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - أنوية صوت Yamaha FM (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - النوافذ والإدخال والصوت"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - واجهة المستخدم هذه (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - تحليل games.xml"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - فك ضغط أرشيفات ZIP"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - فك ضغط أرشيفات 7-Zip (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - ذاكرة GPU (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - ترجمة المظللات"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - فك ترميز صور الأغلفة (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "صورة يد التحكم - Xelu's Free Controller Prompts (Nicolae Berbece)، CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - جلب الصور الفنية (اختياري)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - تشكيل النصوص للترجمات"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - تخطيط النصوص من اليمين إلى اليسار (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "الصور الفنية والأوصاف من ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net، بواسطة Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "انظر NOTICE للإسناد الكامل لكل مكوّن."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "إذا أردت دعم التطوير:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "حفظ الإعدادات"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "تم الحفظ في %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "المقود متصل."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "لا يوجد مقود متصل. تُطبَّق الإعدادات عند توصيله."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "ردّ فعل القوة"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"قوة المقود في ألعاب القيادة: قوى التوسيط والانعطاف\n"
"المستخلصة من أوامر لوحة القيادة الخاصة باللعبة،\n"
"إضافة إلى هزة اصطدام عندما تصطدم بشيء."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "المقاومة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "عكس ردّ فعل القوة"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"لمقود يدفع برنامج تشغيله في الاتجاه الخاطئ: يسحب\n"
"بعيدًا عن المركز بدلًا من إعادته إليه، وتعمل قوى\n"
"اللعبة في الاتجاه المعاكس."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "الاهتزاز"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"يهتز عند اصطدامات اللعبة، للمقاود التي لا تدعم ردّ فعل\n"
