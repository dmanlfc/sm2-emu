#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "برمجي"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"المُصيِّر الذي يرسم اللعبة. يُطبَّق عند التشغيل\n"
"التالي - احفظ الإعدادات وأعد التشغيل."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "حجم النافذة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "العرض"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
