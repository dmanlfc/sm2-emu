#, no-c-format
msgid "Quit"
msgstr "خروج"

#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "الإعدادات"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "المزامنة العمودية"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "ملء الشاشة"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "عداد FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "الإشعارات على الشاشة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "وضع المسدس الضوئي"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "الفيديو"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"انتظار الفراغ العمودي قبل العرض.\n"
"يمنع التمزق لكنه يضيف تأخيرًا يصل إلى إطار واحد."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "الإشعارات"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "تلقائي (النظام)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "اللغة"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "تلقائي (الأفضل)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "المُصيِّر"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "برمجي"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"المُصيِّر الذي يرسم اللعبة. يُطبَّق عند التشغيل\n"
"التالي - احفظ الإعدادات وأعد التشغيل."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "حجم النافذة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "العرض"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "الارتفاع"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (أصلي)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "مقياس العرض ثلاثي الأبعاد"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"دقة العرض الداخلية ثلاثية الأبعاد. الأعلى أوضح للمشاهد\n"
"ثلاثية الأبعاد (تبقى 2D/HUD حادة). لمحركات GPU فقط؛ يبقى\n"
"المُصيِّر البرمجي بالدقة الأصلية. يُطبَّق عند التشغيل التالي -\n"
"احفظ الإعدادات وأعد التشغيل."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "ثنائي الخطية"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "عدد صحيح"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "الأقرب"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "ثنائي الخطية الحاد"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "تحجيم 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"كيفية تكبير الإطار إلى النافذة.\n"
"يحافظ ثنائي الخطية الحاد على وضوح النص 2D دون الوميض\n"
"الذي يظهره الأقرب عند أحجام نافذة غير صحيحة. العدد الصحيح\n"
"يلتزم بمضاعف كامل (دقة بكسل تامة، مع أشرطة سوداء).\n"
"يُطبَّق فورًا."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (آركيد)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "بكسلات مربعة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "تمديد"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "نسبة العرض"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 هو شكل شاشة الآركيد (الافتراضي).\n"
"البكسلات المربعة تعرض 496x384 الخام (أضيق قليلًا).\n"
"التمديد يملأ النافذة بالكامل. يُطبَّق فورًا."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "مرشح CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"مظهر تجميلي لشاشة الآركيد فوق الإطار النهائي:\n"
"خطوط مسح، وقناع ظل RGB، وتوهج، وانحناء اختياري\n"
"للشاشة. بصري فقط؛ يُطبَّق فورًا."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "خطوط المسح"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "القناع"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "التوهج"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "الانحناء"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "تحسين (تجميلي، يتجاوز العتاد الأصلي)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "متباين الخواص"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "أمين للأصل"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "مرشح الخامات ثلاثية الأبعاد"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(غير مدعوم)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "وحدة GPU هذه لا تدعم الترشيح متباين الخواص."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "تباين الخواص"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "تكبير 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"تنعيم حواف الطبقات 2D (HUD والنصوص والقوائم). يدوّر xBR\n"
"و ScaleFX الأقطار؛ ويحافظ الأمين للأصل على البكسلات الحادة.\n"
"يُطبَّق فورًا."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "ممزوج"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "منقّط"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "الشفافية"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"يرسم العتاد الأسطح الشفافة (الأضواء والزجاج\n"
"والظلال) كرقعة شطرنج. الممزوج يرسم السطح الشفاف بنسبة 50%\n"
"الذي يحاول العتاد تحقيقه. يُطبَّق فورًا."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "خامات مخصصة"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"استبدال خامات اللعبة ثلاثية الأبعاد بصور محفوظة في\n"
"saves/textures/<game>/load بأسماء التفريغ نفسها. لمُصيِّرات\n"
"GPU فقط؛ إعادة التحميل تلتقط الملفات المعدّلة."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "تم تحميل %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "إعادة التحميل"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "تفريغ الخامات"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"جمع كل خامة ثلاثية الأبعاد ترسمها اللعبة وكتابتها،\n"
"مع index.html للتصفح، في saves/textures/<game>/dump\n"
"عند خروج اللعبة أو إيقاف هذا الخيار."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "الصوت"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "المسارات"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "استعراض..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "مجلد الإعدادات"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"المكان الذي يُقرأ منه sm2-emu.ini ويُحفظ فيه.\n"
"يُحدَّد بـ --config <dir>؛ لا يمكن تغييره هنا."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "مجلد ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"مكان أرشيفات ROM. اللعبة التي تُشغَّل باسمها\n"
"تُحمَّل من هنا باسم <name>.zip أو <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "مجلد الحفظ"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"حفظ مدعوم بالبطارية: صور NVRAM (.nv) و EEPROM\n"
"(.eeprom) لكل لعبة -- أعلى النتائج وإعدادات المشغّل."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "مجلد لقطات الشاشة"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "المكان الذي تُكتب فيه لقطات الشاشة بـ F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "جلب الصور الفنية عبر الإنترنت"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"السماح لمنتقي الألعاب بجلب صور الأغلفة والأوصاف من\n"
"ArcadeDB عبر الشبكة. الإيقاف يبقي sm2-emu دون اتصال:\n"
"يظل المنتقي يعرض كل الألعاب ويشغّلها، مع مربعات\n"
"مؤقتة ودون أوصاف."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "يد التحكم"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "المقود"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
