#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"in absolute mouse mode (GUN4IR, Sinden, AimTrak) before launching for "
"independent per-player aiming."
msgstr ""
"Nisu otkriveni namjenski svjetlosni pištolji. Igrač 1 cilja mišem; lijeva "
"tipka puca, a desna puni (pucajte izvan zaslona). Priključite pištolje u "
"načinu apsolutnog miša (GUN4IR, Sinden, AimTrak) prije pokretanja za "
"neovisno ciljanje po igraču."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"tagged ID_INPUT_GUN for independent per-player aiming."
msgstr ""
"Nisu otkriveni namjenski svjetlosni pištolji. Igrač 1 cilja mišem; lijeva "
"tipka puca, a desna puni (pucajte izvan zaslona). Priključite pištolje "
"označene s ID_INPUT_GUN za neovisno ciljanje po igraču."

