#, no-c-format
#~ msgid ""
#~ "Hold Backspace to step back through play.\n"
#~ "Costs a little speed on every frame while on."
#~ msgstr ""
#~ "Držite Backspace za vraćanje unatrag kroz igru.\n"
#~ "Dok je uključeno, svaki okvir malo usporava."

#, no-c-format
#~ msgid ""
#~ "Save the whole machine to a slot and restore it later. Quick-save is F6, "
#~ "quick-load is F7."
#~ msgstr ""
#~ "Spremite cijeli stroj u utor i kasnije ga vratite. Brzo spremanje je F6, "
#~ "brzo učitavanje je F7."

