msgstr "Izlaz"

#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "Postavke"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Cijeli zaslon"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "Brojač FPS-a"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "Obavijesti na zaslonu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "Način svjetlosnog pištolja"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Video"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Čekaj vertikalni povrat prije prikaza.\n"
"Sprječava trganje slike, ali dodaje do jednog okvira kašnjenja."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Obavijesti"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatski (sustav)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Jezik"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Automatski (najbolji)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Iscrtavač"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Softverski"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Koji iscrtavač crta igru. Primjenjuje se pri\n"
"sljedećem pokretanju - spremite postavke i ponovno pokrenite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Veličina prozora"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Širina"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Visina"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (izvorno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Skala 3D iscrtavanja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Interna razlučivost 3D iscrtavanja. Veća daje oštriji 3D\n"
"(2D/HUD ostaje oštar). Samo GPU pozadine; softverski\n"
"iscrtavač ostaje izvoran. Primjenjuje se pri sljedećem\n"
"pokretanju - spremite postavke i ponovno pokrenite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Cjelobrojno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Najbliže"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Oštro bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D skaliranje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Kako se okvir povećava na prozor.\n"
"Oštro bilinearno čuva 2D tekst oštrim bez treperenja\n"
"koje najbliže pokazuje pri necjelobrojnim veličinama.\n"
"Cjelobrojno poravnava na cijeli višekratnik (savršeni\n"
"pikseli, s crnim trakama). Primjenjuje se odmah."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkadno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratni pikseli"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Rastegni"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Omjer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 je oblik arkadnog monitora (zadano).\n"
"Kvadratni pikseli prikazuju sirovih 496x384 (malo usko).\n"
"Rastegni ispunjava cijeli prozor. Primjenjuje se odmah."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT filtar"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Kozmetički izgled arkadnog monitora preko gotovog okvira:\n"
"linije skeniranja, RGB maska sjene, sjaj i neobavezna\n"
"zakrivljenost zaslona. Samo vizualno; primjenjuje se odmah."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Linije skeniranja"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maska"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Sjaj"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Zakrivljenost"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Poboljšanje (kozmetičko, izvan izvornog hardvera)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anizotropno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Vjerno"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filtar 3D tekstura"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(nije podržano)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Ovaj GPU ne prijavljuje anizotropno filtriranje."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anizotropija"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D povećanje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Zaglađuje rubove 2D slojeva (HUD, tekst, izbornici). xBR i\n"
"ScaleFX zaobljuju dijagonale; Vjerno čuva oštre piksele.\n"
"Primjenjuje se odmah."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Stopljeno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Točkasto"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Prozirnost"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Hardver crta prozirne površine (svjetla, staklo,\n"
"sjene) kao šahovnicu. Stopljeno crta 50% prozirnu\n"
"površinu koju pokušava postići. Primjenjuje se odmah."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Prilagođene teksture"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Zamjenjuje 3D teksture igre slikama spremljenima u\n"
"saves/textures/<game>/load, nazvanima kao pri izvozu. Samo\n"
"GPU iscrtavači; Ponovno učitaj preuzima uređene datoteke."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "Učitano: %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Ponovno učitaj"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Izvezi teksture"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Prikuplja svaku 3D teksturu koju igra crta i zapisuje ih,\n"
"s index.html za pregled, u saves/textures/<game>/dump\n"
"kad se igra zatvori ili se ovo isključi."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Zvuk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Putanje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Pregledaj..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Mapa konfiguracije"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Odakle se sm2-emu.ini čita i kamo se sprema.\n"
"Postavlja se s --config <dir>; ovdje se ne može promijeniti."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Mapa ROM-ova"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Gdje se nalaze ROM arhive. Igra pokrenuta po imenu\n"
"učitava se odavde kao <name>.zip ili <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mapa spremanja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Spremanja s baterijom: NVRAM (.nv) i EEPROM (.eeprom)\n"
"slike po igri -- najbolji rezultati i postavke operatera."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mapa snimki zaslona"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Gdje se zapisuju snimke zaslona tipkom F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Preuzmi slike s interneta"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Dopušta odabiru igara preuzimanje omota i opisa s\n"
"ArcadeDB-a putem mreže. Isključeno drži sm2-emu izvan mreže:\n"
"odabir i dalje prikazuje i pokreće sve igre, sa zamjenskim\n"
"pločicama i bez opisa."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "Kontroler"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "Volan"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
msgstr "Svjetlosni pištolj"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
msgstr "Mreža"

#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "Stanja"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "O programu"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "Emulator arkadnog sustava Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "BSD licenca s 3 klauzule. Pogledajte LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu postoji zahvaljujući otvorenom kodu podijeljenom sa zajednicom."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "Zahvaljujemo projektima čiji kod ovo omogućuje:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "Projekt MAME - smjernice za emulaciju Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - jezgra procesora Motorola 68000 (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - Yamaha FM zvučne jezgre (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - prozori, ulaz i zvuk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - ovo korisničko sučelje (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - čitanje games.xml"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - raspakiravanje ZIP arhiva"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - raspakiravanje 7-Zip arhiva (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - GPU memorija (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - prevođenje shadera"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - dekodiranje slika omota (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "Slika kontrolera - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - preuzimanje slika (neobavezno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - oblikovanje teksta za prijevode"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - raspored teksta zdesna nalijevo (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Slike i opisi igara s ArcadeDB-a"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, autor Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Pogledajte NOTICE za potpune navode po komponentama."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Ako želite podržati razvoj:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Spremi postavke"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Spremljeno u %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Volan je povezan."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Nijedan volan nije povezan. Postavke vrijede kad se poveže."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Povratna sila"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Sila na volanu u vožnji: sile centriranja i zavoja\n"
"dekodirane iz naredbi pogonske ploče same igre,\n"
"plus trzaj pri udarcu kad u nešto udarite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Otpor"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Obrni povratnu silu"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"Za volan čiji upravljački program gura u krivu stranu: vuče\n"
"od središta umjesto da ga vraća, a sile\n"
"igre idu u suprotnom smjeru."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibracija"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrira pri udarcima u igri, za volane bez povratne\n"
"sile. Nikad ne radi istodobno s povratnom silom."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Jačina vibracije"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Vibracija motora"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"Dodatna vibracija koja raste s gasom. Ne dolazi\n"
"iz igre. Isključite je da osjećate samo povratnu silu igre."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u °"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Raspon upravljanja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Postavite na raspon okretanja svojeg volana. Kut\n"
"zaključavanja ispod preslikava se na njega, pa usklađivanje\n"
"s volanom daje odziv kao na arkadnom uređaju."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Kut zaključavanja"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d °"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Koliko fizički okrenuti za puni zaokret u igri (ukupno,\n"
"dakle pola na svaku stranu). Manje je osjetljivije."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Osi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr "Automatski otkriveno. Ponovno kalibrirajte ako upravljanje ili pedala ne radi ispravno."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Upravljanje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Gas"

#: src/osd/gui.cpp
#, no-c-format
