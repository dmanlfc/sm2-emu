#, c-format
msgid "Gun %zu (player %zu): %s"
msgstr "Όπλο %zu (παίκτης %zu): %s"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"in absolute mouse mode (GUN4IR, Sinden, AimTrak) before launching for "
"independent per-player aiming."
msgstr ""
"Δεν εντοπίστηκαν ειδικά όπλα φωτός. Ο Παίκτης 1 σκοπεύει με το ποντίκι· το αριστερό κουμπί πυροβολεί και το δεξί γεμίζει (βολή εκτός οθόνης). Συνδέστε όπλα σε λειτουργία απόλυτου ποντικιού (GUN4IR, Sinden, AimTrak) πριν την εκκίνηση για ανεξάρτητη σκόπευση ανά παίκτη."

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"No dedicated light guns detected. Player 1 aims with the mouse; the left "
"button fires and the right button reloads (shoot off screen). Plug in guns "
"tagged ID_INPUT_GUN for independent per-player aiming."
msgstr ""
"Δεν εντοπίστηκαν ειδικά όπλα φωτός. Ο Παίκτης 1 σκοπεύει με το ποντίκι· το αριστερό κουμπί πυροβολεί και το δεξί γεμίζει (βολή εκτός οθόνης). Συνδέστε όπλα με ετικέτα ID_INPUT_GUN για ανεξάρτητη σκόπευση ανά παίκτη."

