#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "Configuració"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Pantalla completa"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "Comptador d'FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "Notificacions en pantalla"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "Mode pistola de llum"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Vídeo"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Espera el retraçament vertical abans de mostrar.\n"
"Evita l'esquinçament però afegeix fins a un fotograma de latència."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notificacions"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automàtic (sistema)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Idioma"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Automàtic (el millor)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderitzador"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programari"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Quin renderitzador dibuixa el joc. S'aplica en el\n"
"proper inici - deseu la configuració i reinicieu."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Mida de la finestra"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Amplada"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Alçada"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (nativa)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Escala de renderitzat 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Resolució interna del renderitzat 3D. Més alta, 3D més\n"
"nítid (el 2D/HUD es manté nítid). Només motors de GPU; el\n"
"renderitzador per programari es manté natiu. S'aplica en\n"
"el proper inici - deseu la configuració i reinicieu."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Sencer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Més proper"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Bilineal nítid"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Escalat 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Com s'amplia el fotograma a la finestra.\n"
"Bilineal nítid manté el text 2D nítid sense el parpelleig\n"
"que mostra el més proper en mides no senceres. Sencer ajusta\n"
"a un múltiple exacte (píxel perfecte, amb barres negres).\n"
"S'aplica a l'instant."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Píxels quadrats"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Estira"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Aspecte"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 és la forma del monitor de l'arcade (per defecte).\n"
"Píxels quadrats mostra els 496x384 en brut (una mica estret).\n"
"Estira omple tota la finestra. S'aplica a l'instant."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filtre CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Un aspecte cosmètic de monitor d'arcade sobre el fotograma final:\n"
"línies d'escaneig, màscara d'ombra RGB, resplendor i curvatura\n"
"de pantalla opcional. Purament visual; s'aplica a l'instant."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Línies d'escaneig"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Màscara"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Resplendor"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Curvatura"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Millora (cosmètica, més enllà del maquinari original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotròpic"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Fidel"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filtre de textures 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(no compatible)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Aquesta GPU no indica suport per al filtratge anisotròpic."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropia"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Escalat 2D millorat"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Suavitza les vores de les capes 2D (HUD, text, menús). xBR i\n"
"ScaleFX arrodoneixen les diagonals; Fidel manté els píxels nítids.\n"
"S'aplica a l'instant."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Barrejat"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Puntejat"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Translucidesa"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"El maquinari dibuixa les superfícies transparents (llums, vidre,\n"
"ombres) com un tauler d'escacs. Barrejat dibuixa la superfície\n"
"50% transparent que intenta aconseguir. S'aplica a l'instant."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Textures personalitzades"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Substitueix les textures 3D del joc per imatges desades a\n"
"saves/textures/<game>/load, amb el nom de l'extracció. Només\n"
"renderitzadors de GPU; Recarrega llegeix els fitxers editats."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu carregades"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Recarrega"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Extreu textures"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Recull cada textura 3D que dibuixa el joc i les escriu,\n"
"amb un index.html per navegar-hi, a saves/textures/<game>/dump\n"
"quan el joc surt o es desactiva aquesta opció."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Àudio"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Camins"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Navega..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Directori de configuració"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"On es llegeix i es desa sm2-emu.ini.\n"
"Es defineix amb --config <dir>; no es pot canviar aquí."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Directori de ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"On són els arxius de ROM. Un joc iniciat pel nom es\n"
"carrega des d'aquí com a <name>.zip o <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Directori de partides desades"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Desades amb bateria: imatges NVRAM (.nv) i EEPROM (.eeprom)\n"
"per joc -- rècords i configuració de l'operador."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Directori de captures de pantalla"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "On s'escriuen les captures de pantalla d'F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Obtén imatges en línia"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Permet que el selector de jocs obtingui portades i descripcions\n"
"d'ArcadeDB per la xarxa. Desactivat manté sm2-emu fora de línia:\n"
"el selector encara llista i inicia tots els jocs, amb miniatures\n"
"genèriques i sense descripcions."

