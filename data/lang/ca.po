msgstr "Llicència BSD de 3 clàusules. Vegeu LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu existeix gràcies al codi obert compartit amb la comunitat."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "Amb agraïment als projectes el codi dels quals ho fa possible:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "El projecte MAME - orientació per a l'emulació del Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
