#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Pred prikazom počakaj na navpični povratek.\n"
"Prepreči trganje slike, a doda do eno sličico zakasnitve."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Obvestila"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Samodejno (najboljši)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Upodabljalnik"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programski"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Kateri upodabljalnik riše igro. Uveljavi se ob\n"
"naslednjem zagonu - shranite nastavitve in znova zaženite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Velikost okna"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Širina"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Višina"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (izvorno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Merilo 3D upodabljanja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Notranja ločljivost 3D upodabljanja. Višja je ostrejši 3D\n"
"(2D/HUD ostane oster). Samo za GPU zaledja; programski\n"
"upodabljalnik ostane izvoren. Uveljavi se ob naslednjem\n"
"zagonu - shranite nastavitve in znova zaženite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Celoštevilsko"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Najbližje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Ostro bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D skaliranje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Kako se sličica poveča na okno.\n"
"Ostro bilinearno ohrani 2D besedilo ostro brez migetanja,\n"
"ki ga „Najbližje“ kaže pri neceloštevilskih velikostih okna.\n"
"„Celoštevilsko“ uporabi cel večkratnik (natančne slikovne\n"
"pike, s črnimi pasovi). Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "16:9 (widescreen)"
msgstr "16:9 (široki zaslon)"

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkadno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratne pike"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Raztegni"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Razmerje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"16:9 (experimental) draws the 3D wider, with the 2D in the middle.\n"
"Stretch fills the whole window.\n"
"GPU renderers only. Applies live."
msgstr ""
"4:3 je oblika arkadnega monitorja (privzeto).\n"
"Kvadratne pike prikažejo surovih 496x384 (nekoliko ozko).\n"
"16:9 (poskusno) riše 3D širše, z 2D na sredini.\n"
"Raztegni zapolni celo okno.\n"
"Samo upodabljalniki GPU. Velja takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Brightness"
msgstr "Svetlost"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 2 picture's black sits. 50% is the default,\n"
"matched to an arcade capture; lower is darker, higher is\n"
"brighter. Applies live."
msgstr ""
"Kje leži črna v sliki Model 2. 50 % je privzeto,\n"
"po posnetku z avtomata; manj je temneje, več je svetleje.\n"
"Velja takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filter CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Kozmetični videz arkadnega monitorja prek končne sličice:\n"
"vrstične črte, RGB senčna maska, žarenje in izbirna\n"
"ukrivljenost zaslona. Zgolj vizualno; uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Vrstične črte"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maska"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Žarenje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Ukrivljenost"

#: src/osd/gui.cpp
#, no-c-format
msgid "Bezel"
msgstr "Okvir"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"In fullscreen, frame the 4:3 picture with an image from\n"
"the bezels directory (Paths tab): <game>.png, the parent\n"
"set's, or default.png. The picture fills the image's\n"
"transparent window."
msgstr ""
"V celozaslonskem načinu uokviri sliko 4:3 s sliko iz\n"
"mape okvirjev (zavihek Poti): <game>.png, sliko\n"
"nadrejenega nabora ali default.png. Slika igre zapolni\n"
"prosojno okno slike."

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Izboljšave (kozmetične, onkraj izvirne strojne opreme)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anizotropno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Izvirno"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filter 3D tekstur"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(ni podprto)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Ta GPU ne poroča o anizotropnem filtriranju."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anizotropija"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D povečava"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Zgladi robove 2D plasti (HUD, besedilo, meniji). xBR in\n"
"ScaleFX zaokrožita diagonale; „Izvirno“ ohrani ostre\n"
"slikovne pike. Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Zlito"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Pikčasto"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Prosojnost"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Strojna oprema riše prosojne površine (luči, steklo,\n"
"sence) kot šahovnico. „Zlito“ nariše 50%\n"
"prosojno površino, ki jo želi doseči. Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Extended draw distance"
msgstr "Razširjena razdalja izrisa"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw the scenery to the edge of the course instead of\n"
"the arcade's short range, so it no longer pops in.\n"
"Daytona USA only. Applies live."
msgstr ""
"Izriše pokrajino do roba proge namesto\n"
"kratkega dosega avtomata, da se ne pojavi več nenadoma.\n"
"Samo Daytona USA. Velja takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Teksture po meri"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Zamenjaj 3D teksture igre s slikami, shranjenimi v\n"
"saves/textures/<game>/load, poimenovanimi kot ob izvozu.\n"
"Samo GPU upodabljalniki; „Znova naloži“ prebere urejene datoteke."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "Naloženih: %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Znova naloži"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Izvozi teksture"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Zberi vse 3D teksture, ki jih igra nariše, in jih zapiši\n"
"skupaj z index.html za brskanje v saves/textures/<game>/dump,\n"
"ko se igra konča ali ko to izklopite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Zvok"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Poti"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Prebrskaj..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Mapa nastavitev"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where keisho.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Od kod se keisho.ini bere in kam se shranjuje.\n"
"Nastavi se z --config <dir>; tu ga ni mogoče spremeniti."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Mapa ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Kje so arhivi ROM. Igra, zagnana po imenu, se\n"
"naloži od tod kot <name>.zip ali <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Model 1 ROM directory"
msgstr "Mapa ROM za Model 1"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 1 ROM archives live.\n"
"Empty means the ROM directory."
msgstr ""
"Kje so arhivi ROM za Model 1.\n"
"Prazno pomeni mapo ROM."

#: src/osd/gui.cpp
#, no-c-format
msgid "Model 3 ROM directory"
msgstr "Mapa ROM za Model 3"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the Model 3 ROM archives live.\n"
"Empty means the ROM directory."
msgstr ""
"Kje so arhivi ROM za Model 3.\n"
"Prazno pomeni mapo ROM."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mapa shranjenih"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Shranjeno z baterijo: NVRAM (.nv) in EEPROM (.eeprom)\n"
"slike za vsako igro -- najboljši rezultati in nastavitve operaterja."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mapa posnetkov zaslona"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where screenshots are written."
msgstr "Kam se zapišejo posnetki zaslona."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bezels directory"
msgstr "Mapa okvirjev"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Bezel images: <game>.png, the parent set's, or default.png.\n"
"Empty means a bezels folder beside keisho.ini."
msgstr ""
"Slike okvirjev: <game>.png, nadrejenega nabora ali default.png.\n"
"Prazno pomeni mapo bezels poleg keisho.ini."

#: src/osd/gui.cpp
#, no-c-format
msgid "Crosshairs directory"
msgstr "Mapa merkov"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Crosshair images: <game>-p1.png (-p2 for player 2) or\n"
"<game>.png for both, then the parent set's, then default.\n"
"Drawn at their own size on a 1080-line picture. Without\n"
"one the built-in crosshair is drawn.\n"
"Empty means a crosshairs folder beside keisho.ini."
msgstr ""
"Slike merkov: <game>-p1.png (-p2 za igralca 2) ali\n"
"<game>.png za oba, nato starševskega kompleta, nato default.\n"
"Narisane v svoji velikosti na sliki s 1080 vrsticami. Brez\n"
"slike se nariše vgrajeni merek.\n"
"Prazno pomeni mapo crosshairs poleg keisho.ini."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Prenašaj slike s spleta"

