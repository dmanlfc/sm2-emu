msgstr "Skrij prekrivni sloj"

#: src/osd/gui.cpp
#, no-c-format
msgid "Quit"
msgstr "Izhod"

#: src/osd/gui.cpp
#, no-c-format
msgid "Settings"
msgstr "Nastavitve"

#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "Vsync"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "Celozaslonski način"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "Števec FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "Obvestila na zaslonu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "Način svetlobne pištole"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Video"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Pred prikazom počakaj na navpični povratek.\n"
"Prepreči trganje slike, a doda do eno sličico zakasnitve."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Obvestila"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Samodejno (sistem)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Jezik"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Samodejno (najboljši)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Upodabljalnik"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Programski"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Kateri upodabljalnik riše igro. Uveljavi se ob\n"
"naslednjem zagonu - shranite nastavitve in znova zaženite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Velikost okna"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Širina"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Višina"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (izvorno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Merilo 3D upodabljanja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Notranja ločljivost 3D upodabljanja. Višja je ostrejši 3D\n"
"(2D/HUD ostane oster). Samo za GPU zaledja; programski\n"
"upodabljalnik ostane izvoren. Uveljavi se ob naslednjem\n"
"zagonu - shranite nastavitve in znova zaženite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Celoštevilsko"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Najbližje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Ostro bilinearno"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D skaliranje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Kako se sličica poveča na okno.\n"
"Ostro bilinearno ohrani 2D besedilo ostro brez migetanja,\n"
"ki ga „Najbližje“ kaže pri neceloštevilskih velikostih okna.\n"
"„Celoštevilsko“ uporabi cel večkratnik (natančne slikovne\n"
"pike, s črnimi pasovi). Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkadno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratne pike"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Raztegni"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Razmerje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 je oblika arkadnega monitorja (privzeto).\n"
"Kvadratne pike prikažejo surovo 496x384 (malce ozko).\n"
"„Raztegni“ zapolni celo okno. Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filter CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Kozmetični videz arkadnega monitorja prek končne sličice:\n"
"vrstične črte, RGB senčna maska, žarenje in izbirna\n"
"ukrivljenost zaslona. Zgolj vizualno; uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Vrstične črte"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maska"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Žarenje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Ukrivljenost"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Izboljšave (kozmetične, onkraj izvirne strojne opreme)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anizotropno"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Izvirno"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filter 3D tekstur"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(ni podprto)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Ta GPU ne poroča o anizotropnem filtriranju."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anizotropija"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D povečava"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Zgladi robove 2D plasti (HUD, besedilo, meniji). xBR in\n"
"ScaleFX zaokrožita diagonale; „Izvirno“ ohrani ostre\n"
"slikovne pike. Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Zlito"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Pikčasto"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Prosojnost"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Strojna oprema riše prosojne površine (luči, steklo,\n"
"sence) kot šahovnico. „Zlito“ nariše 50%\n"
"prosojno površino, ki jo želi doseči. Uveljavi se takoj."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Teksture po meri"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Zamenjaj 3D teksture igre s slikami, shranjenimi v\n"
"saves/textures/<game>/load, poimenovanimi kot ob izvozu.\n"
"Samo GPU upodabljalniki; „Znova naloži“ prebere urejene datoteke."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "Naloženih: %zu"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Znova naloži"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Izvozi teksture"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Zberi vse 3D teksture, ki jih igra nariše, in jih zapiši\n"
"skupaj z index.html za brskanje v saves/textures/<game>/dump,\n"
"ko se igra konča ali ko to izklopite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Zvok"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Poti"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Prebrskaj..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Mapa nastavitev"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Od kod se sm2-emu.ini bere in kam se shranjuje.\n"
"Nastavi se z --config <dir>; tu ga ni mogoče spremeniti."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Mapa ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Kje so arhivi ROM. Igra, zagnana po imenu, se\n"
"naloži od tod kot <name>.zip ali <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mapa shranjenih"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Shranjeno z baterijo: NVRAM (.nv) in EEPROM (.eeprom)\n"
"slike za vsako igro -- najboljši rezultati in nastavitve operaterja."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mapa posnetkov zaslona"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Kam se zapišejo posnetki zaslona s F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Prenašaj slike s spleta"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Dovoli izbirniku iger, da prek omrežja iz ArcadeDB prenese\n"
"slike škatel in opise. Izklopljeno ohrani sm2-emu brez\n"
"povezave: izbirnik še vedno prikaže in zažene vse igre,\n"
"z nadomestnimi ploščicami in brez opisov."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "Igralni plošček"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "Volan"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
msgstr "Svetlobna pištola"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
msgstr "Omrežje"

#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "Stanja"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "O programu"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "Emulator arkadnih avtomatov Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "Licenca BSD 3-Clause. Glejte LICENSE."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu obstaja zaradi odprte kode, deljene s skupnostjo."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "Zahvala projektom, katerih koda to omogoča:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "Projekt MAME - smernice za emulacijo Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - jedro CPU Motorola 68000 (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - zvočna jedra Yamaha FM (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - okna, vnos in zvok"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - ta uporabniški vmesnik (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - razčlenjevanje games.xml"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - razširjanje arhivov ZIP"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - razširjanje arhivov 7-Zip (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - pomnilnik GPU (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - prevajanje senčilnikov"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - dekodiranje slik škatel (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr "Slika igralnega ploščka - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - prenos slik (izbirno)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - oblikovanje besedila za prevode"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - postavitev besedila od desne proti levi (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Slike in opisi iger iz ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, avtor Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Celotno navedbo avtorstva po komponentah najdete v NOTICE."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Če želite podpreti razvoj:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Shrani nastavitve"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Shranjeno v %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Volan povezan."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Volan ni povezan. Nastavitve bodo veljale, ko bo povezan."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Povratna sila"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Sila volana v dirkalnih igrah: sile centriranja in zavijanja,\n"
"dekodirane iz ukazov igrine krmilne plošče volana,\n"
"ter sunek ob trku, ko se v kaj zaletite."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Upor"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Obrni povratno silo"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"Za volan, katerega gonilnik potiska v napačno smer: vleče\n"
"stran od sredine, namesto da ga vrača, in sile igre\n"
"delujejo v nasprotno smer."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibriranje"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrira ob udarcih v igri, za volane brez povratne\n"
"sile. Nikoli ne deluje skupaj s povratno silo."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Moč vibriranja"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Vibriranje motorja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"Dodano vibriranje, ki narašča s plinom. Ne prihaja\n"
"iz igre. Izklopite ga, da čutite le povratno silo igre."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u°"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Obseg krmiljenja"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Nastavite na lasten obseg vrtenja volana. Spodnji\n"
"kot zasuka se preslika nanj, zato ujemanje z volanom\n"
"da arkadni odziv."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Kot zasuka"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d°"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Kako daleč fizično zasukati za poln zasuk v igri (skupaj,\n"
"torej polovica na vsako stran). Manjše je bolj občutljivo."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Osi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr "Samodejno zaznano. Ponovno umerite, če krmiljenje ali pedal ne deluje pravilno."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Krmiljenje"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Plin"

#: src/osd/gui.cpp
#, no-c-format
