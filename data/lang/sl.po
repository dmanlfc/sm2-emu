#, no-c-format
msgid "Automatic (system)"
msgstr "Samodejno (sistem)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Jezik"

#: src/osd/gui.cpp
#, no-c-format
msgid "Background controller input"
msgstr "Vnos krmilnikov v ozadju"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheels and gamepads keep working while the window is\n"
"not in front. Keyboard and mouse still need the window\n"
"in front."
msgstr ""
"Volani in igralni ploščki delujejo tudi, ko okno\n"
"ni v ospredju. Tipkovnica in miška še vedno\n"
"potrebujeta okno v ospredju."

#: src/osd/gui.cpp
#, c-format
msgid ""
"Hold %s to step back through play.\n"
"Costs a little speed on every frame while on."
msgstr ""
"Držite %s za previjanje igre nazaj.\n"
"Med vklopom vsaka sličica stane nekaj hitrosti."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rewind memory"
msgstr "Pomnilnik previjanja"

#: src/osd/gui.cpp
#, no-c-format
msgid "Cabinet outputs"
msgstr "Izhodi avtomata"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network outputs"
msgstr "Omrežni izhodi"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Send lamps, gun recoil and drive-board output to\n"
"MAMEHooker, Hook Of The Reaper and similar tools,\n"
"using MAME's network output protocol."
msgstr ""
"Pošilja lučke, odsun pištole in izhod pogonske plošče\n"
"v MAMEHooker, Hook Of The Reaper in podobna orodja\n"
"prek protokola omrežnih izhodov MAME."

#: src/osd/gui.cpp
#, no-c-format
msgid "Port"
msgstr "Vrata"

#: src/osd/gui.cpp
#, no-c-format
msgid "Windows outputs"
msgstr "Izhodi Windows"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The same outputs over MAME's Windows message\n"
"protocol, for tools that hook MAME that way."
msgstr ""
"Isti izhodi prek protokola sporočil Windows iz MAME,\n"
"za orodja, ki se na MAME priklopijo na ta način."

#: src/osd/gui.cpp
#, no-c-format
