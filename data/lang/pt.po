#, no-c-format
msgid "Show crosshair"
msgstr "Mostrar mira"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Draw sm2-emu's own crosshair. Turn off if the gun\n"
"has its own sight (e.g. a Sinden). Positional-gun\n"
"titles always draw their own regardless."
msgstr ""
"Desenha a mira própria do sm2-emu. Desligue se a pistola\n"
"tiver mira própria (p. ex. uma Sinden). Os jogos de pistola\n"
"posicional desenham sempre a sua de qualquer forma."

#: src/osd/gui.cpp
#, no-c-format
msgid "Hide shot flash"
msgstr "Ocultar clarão do disparo"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Hide the white flash Virtua Cop, Virtua Cop 2 and\n"
"House of the Dead show on each shot."
msgstr ""
"Oculta o clarão branco que Virtua Cop, Virtua Cop 2 e\n"
"House of the Dead mostram a cada disparo."

