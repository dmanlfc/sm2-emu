msgstr "HarfBuzz - modelação de texto para as traduções"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - disposição de texto da direita para a esquerda (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
