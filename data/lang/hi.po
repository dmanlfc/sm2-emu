msgstr "कोई विवरण उपलब्ध नहीं।"

#, no-c-format
#~ msgid "Light-gun mode"
#~ msgstr "लाइट-गन मोड"

#, no-c-format
#~ msgid ""
#~ "Show the aiming crosshair and hide the mouse cursor,\n"
#~ "for the light-gun titles (Virtua Cop 2, House of the\n"
#~ "Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)."
#~ msgstr ""
#~ "निशाने का क्रॉसहेयर दिखाएँ और माउस कर्सर छिपाएँ,\n"
#~ "लाइट-गन गेम के लिए (Virtua Cop 2, House of the\n"
#~ "Dead, Gunblade NY, Rail Chase 2, Behind Enemy Lines)।"

#, no-c-format
#~ msgid ""
#~ "Player 1 aims with the mouse; the left button fires and the right button "
#~ "reloads (shoot off screen)."
#~ msgstr ""
#~ "खिलाड़ी 1 माउस से निशाना लगाता है; बायाँ बटन गोली चलाता है और दायाँ बटन रीलोड "
#~ "करता है (स्क्रीन के बाहर शूट)।"

#, no-c-format
#~ msgid "Where F12 screenshots are written."
#~ msgstr "F12 स्क्रीनशॉट कहाँ लिखे जाते हैं।"

#, no-c-format
#~ msgid ""
#~ "Hold Backspace to step back through play.\n"
#~ "Costs a little speed on every frame while on."
#~ msgstr ""
#~ "गेमप्ले में पीछे जाने के लिए Backspace दबाए रखें।\n"
#~ "चालू रहने पर हर फ़्रेम में थोड़ी गति कम होती है।"

#, no-c-format
#~ msgid ""
#~ "Save the whole machine to a slot and restore it later. Quick-save is F6, "
#~ "quick-load is F7."
#~ msgstr ""
#~ "पूरी मशीन को एक स्लॉट में सहेजें और बाद में बहाल करें। त्वरित सेव F6 है, त्वरित लोड F7 है।"

#, no-c-format
#~ msgid "F10: toggle overlay"
#~ msgstr "F10: ओवरले टॉगल"

#, no-c-format
#~ msgid "Enter: launch   F10: settings   F9: quit"
#~ msgstr "Enter: चलाएँ   F10: सेटिंग्स   F9: बाहर"

#, no-c-format
#~ msgid ""
#~ "4:3 is the arcade monitor's shape (the default).\n"
#~ "Square pixels shows the raw 496x384 (slightly narrow).\n"
#~ "Stretch fills the whole window. Applies live."
#~ msgstr ""
#~ "4:3 आर्केड मॉनिटर का आकार है (डिफ़ॉल्ट)।\n"
#~ "वर्गाकार पिक्सेल मूल 496x384 दिखाता है (थोड़ा संकरा)।\n"
#~ "खींचें पूरी विंडो भर देता है। तुरंत लागू होता है।"

#, no-c-format
#~ msgid ""
#~ "The left stick also moves; the shoulders also act as Button 3/4. Right "
#~ "Lever is Virtual On's. Test and Service are Guide+Start and Guide+Back."
#~ msgstr ""
#~ "बायाँ स्टिक भी चलाता है; शोल्डर बटन बटन 3/4 का काम भी करते हैं। दायाँ लीवर "
#~ "Virtual On के लिए है। टेस्ट और सर्विस Guide+Start और Guide+Back हैं।"

#, no-c-format
#~ msgid "Read in the background"
#~ msgstr "बैकग्राउंड में पढ़ें"

#, no-c-format
#~ msgid ""
#~ "Wheels and gamepads keep working while the emulator's\n"
#~ "window is not in front: a wheel or a panel driven from\n"
#~ "another program (a cabinet panel through vJoy, say) still\n"
#~ "steers the game, and its buttons and axes can be bound\n"
#~ "below without clicking back into this window. The\n"
#~ "keyboard and the mouse still need the window in front."
#~ msgstr ""
#~ "एम्युलेटर की विंडो सामने न हो तब भी व्हील और गेमपैड काम\n"
#~ "करते हैं: किसी दूसरे प्रोग्राम से चलने वाला व्हील या पैनल (जैसे\n"
#~ "vJoy से कैबिनेट पैनल) फिर भी गेम चलाता है, और इस विंडो में\n"
#~ "वापस क्लिक किए बिना नीचे उसके बटन और अक्ष जोड़े जा सकते हैं।\n"
#~ "कीबोर्ड और माउस के लिए विंडो सामने होनी चाहिए।"

#, no-c-format
#~ msgid "Throttle Up"
#~ msgstr "थ्रॉटल बढ़ाएँ"

#, no-c-format
#~ msgid "Throttle Down"
#~ msgstr "थ्रॉटल घटाएँ"
