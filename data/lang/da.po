#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "Video"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Vent på lodret blanking før visning.\n"
"Forhindrer tearing, men giver op til ét billedes forsinkelse."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notifikationer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatisk (system)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Sprog"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (bedst)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Software"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Hvilken renderer der tegner spillet. Gælder ved\n"
"næste start - gem indstillingerne og start igen."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Vinduesstørrelse"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Bredde"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Højde"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D-renderingsskala"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Intern 3D-opløsning. Højere giver skarpere 3D\n"
"(2D/HUD forbliver skarpt). Kun GPU-backends; software-\n"
"rendereren forbliver original. Gælder ved næste start -\n"
"gem indstillingerne og start igen."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineær"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Heltal"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Nærmeste"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Skarp bilineær"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D-skalering"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Hvordan billedet forstørres til vinduet.\n"
"Skarp bilineær holder 2D-tekst skarp uden det flimmer,\n"
"nærmeste giver ved ikke-heltallige vinduesstørrelser. Heltal\n"
"låser til et helt multiplum (pixelperfekt, med sorte bjælker).\n"
"Gælder straks."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arkade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Kvadratiske pixels"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Stræk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Billedformat"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 er arkademonitorens form (standard).\n"
"Kvadratiske pixels viser de rå 496x384 (lidt smalt).\n"
"Stræk fylder hele vinduet. Gælder straks."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT-filter"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Et kosmetisk arkademonitor-look over det færdige billede:\n"
"scanlines, en RGB-skyggemaske, glød og valgfri skærm-\n"
"krumning. Rent visuelt; gælder straks."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanlines"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maske"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Glød"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Krumning"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Forbedring (kosmetisk, ud over den originale hardware)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotropisk"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Tro mod originalen"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D-teksturfilter"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(ikke understøttet)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Denne GPU rapporterer ikke anisotropisk filtrering."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropi"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D-opskalering"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Udglat kanterne på 2D-lagene (HUD, tekst, menuer). xBR\n"
"og ScaleFX runder diagonaler; Tro mod originalen bevarer\n"
"skarpe pixels. Gælder straks."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Blandet"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Raster"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Gennemsigtighed"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Hardwaren tegner gennemsigtige flader (lys, glas,\n"
"skygger) som et ternet mønster. Blandet tegner den\n"
"50% gennemsigtige flade, der tilsigtes. Gælder straks."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Egne teksturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Erstat spillets 3D-teksturer med billeder gemt i\n"
"saves/textures/<game>/load, navngivet som dumpet.\n"
"Kun GPU-renderere; Genindlæs henter redigerede filer."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu indlæst"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Genindlæs"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Dump teksturer"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Indsaml alle 3D-teksturer, spillet tegner, og skriv dem,\n"
"med en index.html til at gennemse, til saves/textures/<game>/dump\n"
"når spillet afsluttes, eller dette slås fra."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "Lyd"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Stier"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Gennemse..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Konfigurationsmappe"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Hvor sm2-emu.ini læses fra og gemmes til.\n"
"Angives med --config <dir>; kan ikke ændres her."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "ROM-mappe"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Hvor ROM-arkiverne ligger. Et spil startet ved navn\n"
"indlæses herfra som <name>.zip eller <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Mappe til gemte data"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Batterisikrede data: NVRAM- (.nv) og EEPROM-\n"
"(.eeprom) billeder pr. spil -- highscores og operatørindstillinger."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Mappe til skærmbilleder"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Hvor F12-skærmbilleder gemmes."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Hent coverbilleder online"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Lad spilvælgeren hente coverbilleder og beskrivelser fra\n"
"ArcadeDB over netværket. Fra holder sm2-emu offline: vælgeren\n"
"viser og starter stadig alle spil, med pladsholder-\n"
"fliser og uden beskrivelser."

