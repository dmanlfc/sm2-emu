msgstr "LZMA SDK - udpakning af 7-Zip-arkiver (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - GPU-hukommelse (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - shaderkompilering"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - afkodning af coverbilleder (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr ""
"Gamepad-billede - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - hentning af coverbilleder (valgfrit)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - tekstformning til oversættelser"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - tekstlayout fra højre mod venstre (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Spilbilleder og beskrivelser fra ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, af Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "Se NOTICE for fuld kreditering pr. komponent."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "Hvis du vil støtte udviklingen:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "Gem indstillinger"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "Gemt i %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "Rat tilsluttet."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "Intet rat tilsluttet. Indstillingerne gælder, når et tilsluttes."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "Force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"Ratkraft i racerspil: centrerings- og svingkræfter\n"
"afkodet fra spillets egne drivkortskommandoer,\n"
"plus et stød, når du rammer noget."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "Modstand"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "Inverter force feedback"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
"Til et rat, hvis driver skubber den forkerte vej: det trækker\n"
"væk fra midten i stedet for at føre det tilbage,\n"
"og spillets kræfter går den modsatte vej."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble"
msgstr "Vibration"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Vibrates on the game's impacts, for wheels without force\n"
"feedback. It never runs alongside force feedback."
msgstr ""
"Vibrerer ved spillets sammenstød, til rat uden force\n"
"feedback. Kører aldrig samtidig med force feedback."

#: src/osd/gui.cpp
#, no-c-format
msgid "Rumble strength"
msgstr "Vibrationsstyrke"

#: src/osd/gui.cpp
#, no-c-format
msgid "Engine vibration"
msgstr "Motorvibration"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"An added vibration that grows with the throttle. It is not\n"
"from the game. Turn it off to feel only the game's force feedback."
msgstr ""
"En ekstra vibration, der vokser med speederen. Den kommer\n"
"ikke fra spillet. Slå den fra for kun at mærke spillets force feedback."

#: src/osd/gui.cpp
#, c-format
msgid "%u deg"
msgstr "%u grader"

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering range"
msgstr "Ratudslag"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Set this to your wheel's own rotation range. The lock\n"
"angle below is mapped onto it, so matching your wheel\n"
"gives arcade-like response."
msgstr ""
"Sæt dette til dit rats eget drejeområde. Låsevinklen\n"
"nedenfor afbildes på det, så et matchende rat giver\n"
"arkadeagtig respons."

#: src/osd/gui.cpp
#, no-c-format
msgid "Lock angle"
msgstr "Låsevinkel"

#: src/osd/gui.cpp
#, c-format
msgid "%d deg"
msgstr "%d grader"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How far to physically turn for full game lock (total,\n"
"so half each side of centre). Lower is more sensitive."
msgstr ""
"Hvor langt du fysisk drejer for fuldt udslag i spillet\n"
"(i alt, altså halvdelen til hver side). Lavere er mere følsomt."

#: src/osd/gui.cpp
#, no-c-format
msgid "Axes"
msgstr "Akser"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto-detected. Recalibrate if steering or a pedal is wrong."
msgstr ""
"Registreret automatisk. Kalibrer igen, hvis styring eller en pedal er forkert."

#: src/osd/gui.cpp
#, no-c-format
msgid "Steering"
msgstr "Styring"

#: src/osd/gui.cpp
#, no-c-format
msgid "Accelerator"
msgstr "Speeder"

#: src/osd/gui.cpp
#, no-c-format
msgid "Brake"
msgstr "Bremse"

#: src/osd/gui.cpp
#, no-c-format
msgid "auto"
msgstr "auto"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d (inverted)"
msgstr "akse %d (inverteret)"

#: src/osd/gui.cpp
#, c-format
msgid "axis %d"
msgstr "akse %d"

#: src/osd/gui.cpp
#, no-c-format
msgid "operate it..."
msgstr "betjen den..."

#: src/osd/gui.cpp
#, no-c-format
msgid "cancel"
msgstr "annuller"

#: src/osd/gui.cpp
#, no-c-format
msgid "Calibrate"
msgstr "Kalibrer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Buttons"
msgstr "Knapper"

#: src/osd/gui.cpp
#, no-c-format
msgid "Press Bind, then press the wheel button for that control."
msgstr "Tryk på Tildel, og tryk derefter på ratknappen til den funktion."

#: src/osd/gui.cpp
#, no-c-format
msgid "Start"
msgstr "Start"

#: src/osd/gui.cpp
