#: src/osd/gui.cpp
#, no-c-format
msgid ""
"This machine's address on the cabinet LAN. Blank\n"
"listens on every interface. Detect fills it from the\n"
"primary network adapter."
msgstr ""
"Denne maskines adresse på kabinet-LAN'et. Tom\n"
"lytter på alle grænseflader. Registrer udfylder den fra\n"
"den primære netværksadapter."

