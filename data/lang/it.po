#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Cartella configurazione"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Dove sm2-emu.ini viene letto e salvato.\n"
"Si imposta con --config <dir>; non modificabile qui."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Cartella ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Dove si trovano gli archivi ROM. Un gioco avviato per nome\n"
"viene caricato da qui come <name>.zip o <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Cartella salvataggi"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Salvataggi a batteria: immagini NVRAM (.nv) ed EEPROM\n"
"(.eeprom) per gioco -- punteggi e impostazioni operatore."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Cartella screenshot"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Dove vengono scritti gli screenshot di F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Scarica artwork online"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Permette al selettore giochi di scaricare copertine e\n"
"descrizioni da ArcadeDB in rete. Disattivato, sm2-emu resta\n"
"offline: il selettore elenca e avvia comunque ogni gioco,\n"
"con riquadri segnaposto e senza descrizioni."

