#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Attende il vertical blank prima di presentare.\n"
"Evita il tearing ma aggiunge fino a un frame di latenza."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notifiche"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatica (sistema)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Lingua"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (migliore)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Software"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Quale renderer disegna il gioco. Si applica al\n"
"prossimo avvio: salva le impostazioni e riavvia."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Dimensioni finestra"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Larghezza"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Altezza"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (nativa)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Scala di rendering 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Risoluzione interna del rendering 3D. Più alta = 3D più\n"
"nitido (2D/HUD resta nitido). Solo backend GPU; il renderer\n"
"software resta nativo. Si applica al prossimo avvio: salva\n"
"le impostazioni e riavvia."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilineare"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Intero"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Più vicino"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Bilineare nitido"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Scala 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Come l'immagine viene ingrandita nella finestra.\n"
"Bilineare nitido mantiene il testo 2D nitido senza lo\n"
"sfarfallio di Più vicino con dimensioni non intere. Intero\n"
"usa un multiplo esatto (pixel perfetto, con bande nere).\n"
"Si applica subito."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Pixel quadrati"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Estendi"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Proporzioni"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 è la forma del monitor arcade (predefinita).\n"
"Pixel quadrati mostra i 496x384 grezzi (un po' stretto).\n"
"Estendi riempie tutta la finestra. Si applica subito."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filtro CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Un aspetto da monitor arcade sopra l'immagine finale:\n"
"scanline, maschera RGB, bagliore e curvatura dello\n"
"schermo opzionale. Solo estetico; si applica subito."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanline"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maschera"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Bagliore"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Curvatura"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Miglioramento (estetico, oltre l'hardware originale)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotropico"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Fedele"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filtro texture 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(non supportato)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Questa GPU non segnala il filtro anisotropico."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropia"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Upscale 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Smussa i bordi dei livelli 2D (HUD, testo, menu). xBR e\n"
"ScaleFX arrotondano le diagonali; Fedele mantiene i pixel\n"
"nitidi. Si applica subito."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Miscelata"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Retinata"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Trasparenza"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"L'hardware disegna le superfici trasparenti (luci, vetri,\n"
"ombre) come una scacchiera. Miscelata disegna la superficie\n"
"trasparente al 50% che si voleva ottenere. Si applica subito."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Texture personalizzate"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Sostituisce le texture 3D del gioco con immagini salvate in\n"
"saves/textures/<game>/load, con i nomi dell'estrazione.\n"
"Solo renderer GPU; Ricarica legge i file modificati."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu caricate"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Ricarica"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Estrai texture"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Raccoglie ogni texture 3D disegnata dal gioco e le scrive,\n"
"con un index.html da sfogliare, in saves/textures/<game>/dump\n"
"quando il gioco termina o questa opzione viene disattivata."

