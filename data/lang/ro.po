msgstr "HarfBuzz - modelarea textului pentru traduceri"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - aranjare text de la dreapta la stânga (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
