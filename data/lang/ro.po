msgstr "Imagini și descrieri ale jocurilor de la ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net, de Motoschifo)."

#: src/osd/gui.cpp
