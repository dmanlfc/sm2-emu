#, no-c-format
msgid "Audio"
msgstr "Audio"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "Chemins"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "Parcourir..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "Dossier de configuration"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Emplacement de lecture et d'écriture de sm2-emu.ini.\n"
"Défini avec --config <dir> ; non modifiable ici."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Dossier des ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Emplacement des archives ROM. Un jeu lancé par son nom\n"
"est chargé d'ici en tant que <name>.zip ou <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Dossier des sauvegardes"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Sauvegardes sur pile : images NVRAM (.nv) et EEPROM\n"
"(.eeprom) par jeu -- records et réglages opérateur."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Dossier des captures d'écran"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Emplacement des captures d'écran F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Récupérer les visuels en ligne"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Permet au sélecteur de jeux de télécharger jaquettes et\n"
"descriptions depuis ArcadeDB. Désactivé, sm2-emu reste\n"
"hors ligne : le sélecteur liste et lance toujours chaque jeu,\n"
"avec des vignettes génériques et sans description."

