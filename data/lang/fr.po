msgstr "SheenBidi - mise en page du texte de droite à gauche (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "Visuels et descriptions des jeux issus d'ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
