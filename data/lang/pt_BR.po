#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"Onde o sm2-emu.ini é lido e salvo.\n"
"Definida com --config <dir>; não pode ser alterada aqui."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "Pasta de ROMs"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"Onde ficam os arquivos de ROM. Um jogo iniciado pelo nome\n"
"é carregado daqui como <name>.zip ou <name>.7z."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "Pasta de saves"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"Saves com bateria: imagens NVRAM (.nv) e EEPROM (.eeprom)\n"
"por jogo -- recordes e configurações do operador."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "Pasta de capturas de tela"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "Onde as capturas de tela do F12 são gravadas."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "Buscar artes online"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"Permite que o seletor de jogos busque capas e descrições do\n"
"ArcadeDB pela rede. Desligado mantém o sm2-emu offline: o\n"
"seletor ainda lista e inicia todos os jogos, com miniaturas\n"
"genéricas e sem descrições."

