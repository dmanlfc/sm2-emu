#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Aguarda o retraço vertical antes de exibir.\n"
"Evita cortes na imagem, mas adiciona até um quadro de latência."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Notificações"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automático (sistema)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Idioma"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Automático (melhor)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderizador"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Software"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Qual renderizador desenha o jogo. Aplica-se na\n"
"próxima execução - salve as configurações e reinicie."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Tamanho da janela"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Largura"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Altura"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (nativo)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "Escala de render. 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Resolução interna de renderização 3D. Maior deixa o 3D\n"
"mais nítido (2D/HUD continua nítido). Só backends de GPU;\n"
"o renderizador por software fica nativo. Aplica-se na\n"
"próxima execução - salve as configurações e reinicie."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinear"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Inteiro"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Mais próximo"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Bilinear nítido"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "Escala 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Como o quadro é ampliado para a janela.\n"
"Bilinear nítido mantém o texto 2D nítido sem a cintilação\n"
"que o mais próximo mostra em tamanhos não inteiros. Inteiro\n"
"ajusta a um múltiplo exato (pixel perfeito, com barras pretas).\n"
"Aplica-se na hora."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Pixels quadrados"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Esticar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Proporção"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 é o formato do monitor do arcade (o padrão).\n"
"Pixels quadrados mostra os 496x384 brutos (um pouco estreito).\n"
"Esticar preenche toda a janela. Aplica-se na hora."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "Filtro CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Um visual cosmético de monitor de arcade sobre o quadro final:\n"
"scanlines, máscara de sombra RGB, brilho e curvatura de\n"
"tela opcional. Puramente visual; aplica-se na hora."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanlines"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Máscara"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Brilho"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Curvatura"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Aprimoramento (cosmético, além do hardware original)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotrópico"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Fiel"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "Filtro de textura 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(sem suporte)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Esta GPU não informa suporte a filtragem anisotrópica."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropia"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "Ampliação 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Suaviza as bordas das camadas 2D (HUD, texto, menus). xBR e\n"
"ScaleFX arredondam diagonais; Fiel mantém os pixels nítidos.\n"
"Aplica-se na hora."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Mesclado"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Pontilhado"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Translucidez"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"O hardware desenha superfícies transparentes (luzes, vidro,\n"
"sombras) como um tabuleiro xadrez. Mesclado desenha a superfície\n"
"50% transparente que ele tenta obter. Aplica-se na hora."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Texturas personalizadas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Substitui as texturas 3D do jogo por imagens salvas em\n"
"saves/textures/<game>/load, com o nome da extração. Só\n"
"renderizadores de GPU; Recarregar lê arquivos editados."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu carregadas"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Recarregar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Extrair texturas"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Coleta cada textura 3D que o jogo desenha e as grava,\n"
"com um index.html para navegar, em saves/textures/<game>/dump\n"
"quando o jogo fecha ou isto é desativado."

