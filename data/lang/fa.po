#: src/osd/gui.cpp
#, no-c-format
msgid "Vsync"
msgstr "همگام‌سازی عمودی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Fullscreen"
msgstr "تمام‌صفحه"

#: src/osd/gui.cpp
#, no-c-format
msgid "FPS counter"
msgstr "شمارنده FPS"

#: src/osd/gui.cpp
#, no-c-format
msgid "On-screen notifications"
msgstr "اعلان‌های روی صفحه"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light-gun mode"
msgstr "حالت تفنگ نوری"

#: src/osd/gui.cpp
#, no-c-format
msgid "Video"
msgstr "ویدیو"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"پیش از نمایش، منتظر بازگشت عمودی بمان.\n"
"از پارگی تصویر جلوگیری می‌کند اما تا یک فریم تأخیر می‌افزاید."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "اعلان‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "خودکار (سیستم)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "زبان"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "خودکار (بهترین)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "رندرکننده"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "نرم‌افزاری"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"کدام رندرکننده بازی را رسم می‌کند. در اجرای بعدی\n"
"اعمال می‌شود - تنظیمات را ذخیره و دوباره اجرا کنید."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "اندازه پنجره"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "عرض"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "ارتفاع"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (اصلی)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "مقیاس رندر 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"وضوح داخلی رندر 3D. مقدار بالاتر یعنی 3D واضح‌تر\n"
"(2D/HUD تیز می‌ماند). فقط برای GPU؛ رندرکننده نرم‌افزاری\n"
"در وضوح اصلی می‌ماند. در اجرای بعدی اعمال می‌شود -\n"
"تنظیمات را ذخیره و دوباره اجرا کنید."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "دوخطی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "عدد صحیح"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "نزدیک‌ترین"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "دوخطی تیز"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "مقیاس‌دهی 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"نحوه بزرگ‌نمایی فریم در پنجره.\n"
"دوخطی تیز متن 2D را بدون لرزشی که نزدیک‌ترین\n"
"در اندازه‌های غیرصحیح پنجره دارد واضح نگه می‌دارد. عدد صحیح\n"
"به یک مضرب کامل می‌چسبد (پیکسل‌دقیق، با نوار سیاه).\n"
"بلافاصله اعمال می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (آرکید)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "پیکسل مربعی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "کشش"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "نسبت تصویر"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 شکل مانیتور آرکید است (پیش‌فرض).\n"
"پیکسل مربعی 496x384 خام را نشان می‌دهد (کمی باریک).\n"
"کشش کل پنجره را پر می‌کند. بلافاصله اعمال می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "فیلتر CRT"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"ظاهری تزئینی شبیه مانیتور آرکید روی فریم نهایی:\n"
"خطوط اسکن، ماسک سایه RGB، درخشش و انحنای\n"
"اختیاری صفحه. صرفاً بصری؛ بلافاصله اعمال می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "خطوط اسکن"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "ماسک"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "درخشش"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "انحنا"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "بهبود (تزئینی، فراتر از سخت‌افزار اصلی)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "ناهمسانگرد"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "وفادار"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "فیلتر بافت 3D"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(پشتیبانی نمی‌شود)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "این GPU فیلتر ناهمسانگرد را گزارش نمی‌کند."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "ناهمسانگردی"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "بزرگ‌نمایی 2D"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"لبه‌های لایه‌های 2D (HUD، متن، منوها) را نرم می‌کند. xBR و\n"
"ScaleFX قطرها را گرد می‌کنند؛ وفادار پیکسل‌ها را تیز نگه می‌دارد.\n"
"بلافاصله اعمال می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "ترکیبی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "شطرنجی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "شفافیت"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"سخت‌افزار سطوح نیمه‌شفاف (نورها، شیشه، سایه‌ها) را\n"
"به‌صورت شطرنجی رسم می‌کند. ترکیبی همان سطح 50%\n"
"نیمه‌شفاف مورد نظر را رسم می‌کند. بلافاصله اعمال می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "بافت‌های سفارشی"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"بافت‌های 3D بازی را با تصاویر ذخیره‌شده در\n"
"saves/textures/<game>/load، با همان نام دامپ، جایگزین می‌کند.\n"
"فقط رندرکننده‌های GPU؛ «بارگذاری مجدد» فایل‌های ویرایش‌شده را می‌خواند."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu بارگذاری شد"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "بارگذاری مجدد"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "دامپ بافت‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"هر بافت 3D که بازی رسم می‌کند را جمع‌آوری کرده و همراه با\n"
"یک index.html برای مرور، در saves/textures/<game>/dump\n"
"می‌نویسد؛ هنگام خروج از بازی یا خاموش کردن این گزینه."

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "صدا"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "مسیرها"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "مرور..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "پوشه پیکربندی"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"محل خواندن و ذخیره sm2-emu.ini.\n"
"با --config <dir> تنظیم می‌شود؛ اینجا قابل تغییر نیست."

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "پوشه ROM"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"محل آرشیوهای ROM. بازی‌ای که با نام اجرا شود\n"
"از اینجا به‌صورت <name>.zip یا <name>.7z بارگذاری می‌شود."

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "پوشه ذخیره‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"ذخیره‌های باتری‌دار: تصاویر NVRAM (.nv) و EEPROM\n"
"(.eeprom) هر بازی -- امتیازهای برتر و تنظیمات اپراتور."

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "پوشه اسکرین‌شات‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "محل نوشتن اسکرین‌شات‌های F12."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "دریافت تصاویر از اینترنت"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"اجازه می‌دهد انتخابگر بازی تصویر جلد و توضیحات را\n"
"از ArcadeDB از طریق شبکه دریافت کند. خاموش، sm2-emu را آفلاین\n"
"نگه می‌دارد: انتخابگر همچنان همه بازی‌ها را فهرست و اجرا\n"
"می‌کند، با کاشی‌های جایگزین و بدون توضیحات."

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad"
msgstr "دسته بازی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel"
msgstr "فرمان"

#: src/osd/gui.cpp
#, no-c-format
msgid "Light Gun"
msgstr "تفنگ نوری"

#: src/osd/gui.cpp
#, no-c-format
msgid "Network"
msgstr "شبکه"

#: src/osd/gui.cpp
#, no-c-format
msgid "States"
msgstr "وضعیت‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid "About"
msgstr "درباره"

#: src/osd/gui.cpp
#, no-c-format
msgid "A Sega Model 2 arcade emulator"
msgstr "شبیه‌ساز آرکید Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "BSD 3-Clause licence. See LICENSE."
msgstr "مجوز BSD سه‌بندی. LICENSE را ببینید."

#: src/osd/gui.cpp
#, no-c-format
msgid "sm2-emu exists because of open source shared with the community."
msgstr "sm2-emu به لطف متن‌باز به اشتراک‌گذاشته‌شده با جامعه وجود دارد."

#: src/osd/gui.cpp
#, no-c-format
msgid "With thanks to the projects whose code makes it possible:"
msgstr "با سپاس از پروژه‌هایی که کدشان این را ممکن کرده است:"

#: src/osd/gui.cpp
#, no-c-format
msgid "The MAME project - Sega Model 2 emulation guidance"
msgstr "پروژه MAME - راهنمای شبیه‌سازی Sega Model 2"

#: src/osd/gui.cpp
#, no-c-format
msgid "Musashi - Motorola 68000 CPU core (Karl Stenerud)"
msgstr "Musashi - هسته CPU برای Motorola 68000 (Karl Stenerud)"

#: src/osd/gui.cpp
#, no-c-format
msgid "ymfm - Yamaha FM sound cores (Aaron Giles)"
msgstr "ymfm - هسته‌های صوتی Yamaha FM (Aaron Giles)"

#: src/osd/gui.cpp
#, no-c-format
msgid "SDL - windowing, input and audio"
msgstr "SDL - پنجره، ورودی و صدا"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dear ImGui - this user interface (Omar Cornut)"
msgstr "Dear ImGui - همین رابط کاربری (Omar Cornut)"

#: src/osd/gui.cpp
#, no-c-format
msgid "pugixml - games.xml parsing"
msgstr "pugixml - تجزیه games.xml"

#: src/osd/gui.cpp
#, no-c-format
msgid "miniz - ZIP archive decompression"
msgstr "miniz - استخراج آرشیو ZIP"

#: src/osd/gui.cpp
#, no-c-format
msgid "LZMA SDK - 7-Zip archive decompression (Igor Pavlov)"
msgstr "LZMA SDK - استخراج آرشیو 7-Zip (Igor Pavlov)"

#: src/osd/gui.cpp
#, no-c-format
msgid "VulkanMemoryAllocator - GPU memory (AMD / GPUOpen)"
msgstr "VulkanMemoryAllocator - حافظه GPU (AMD / GPUOpen)"

#: src/osd/gui.cpp
#, no-c-format
msgid "shaderc / glslang - shader compilation"
msgstr "shaderc / glslang - کامپایل شیدر"

#: src/osd/gui.cpp
#, no-c-format
msgid "stb_image - box-art image decoding (Sean Barrett)"
msgstr "stb_image - رمزگشایی تصاویر جلد (Sean Barrett)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Gamepad picture - Xelu's Free Controller Prompts (Nicolae Berbece), CC0"
msgstr ""
"تصویر دسته بازی - Xelu's Free Controller Prompts (Nicolae Berbece)، CC0"

#: src/osd/gui.cpp
#, no-c-format
msgid "libcurl - artwork scraping (optional)"
msgstr "libcurl - دریافت تصاویر (اختیاری)"

#: src/osd/gui.cpp
#, no-c-format
msgid "HarfBuzz - text shaping for translations"
msgstr "HarfBuzz - شکل‌دهی متن برای ترجمه‌ها"

#: src/osd/gui.cpp
#, no-c-format
msgid "SheenBidi - right-to-left text layout (Muhammad Tayyab Akram)"
msgstr "SheenBidi - چیدمان متن راست‌به‌چپ (Muhammad Tayyab Akram)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Game artwork and descriptions from ArcadeDB"
msgstr "تصاویر و توضیحات بازی از ArcadeDB"

#: src/osd/gui.cpp
#, no-c-format
msgid "(adb.arcadeitalia.net, by Motoschifo)."
msgstr "(adb.arcadeitalia.net، توسط Motoschifo)."

#: src/osd/gui.cpp
#, no-c-format
msgid "See NOTICE for full per-component attribution."
msgstr "برای انتساب کامل هر جزء، NOTICE را ببینید."

#: src/osd/gui.cpp
#, no-c-format
msgid "If you'd like to support development:"
msgstr "اگر مایلید از توسعه حمایت کنید:"

#: src/osd/gui.cpp
#, no-c-format
msgid "Save settings"
msgstr "ذخیره تنظیمات"

#: src/osd/gui.cpp
#, c-format
msgid "Saved to %s"
msgstr "ذخیره شد در %s"

#: src/osd/gui.cpp
#, no-c-format
msgid "Wheel connected."
msgstr "فرمان متصل است."

#: src/osd/gui.cpp
#, no-c-format
msgid "No wheel connected. Settings still apply once one is."
msgstr "هیچ فرمانی متصل نیست. تنظیمات پس از اتصال اعمال می‌شوند."

#: src/osd/gui.cpp
#, no-c-format
msgid "Force feedback"
msgstr "بازخورد نیرو"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wheel force on driving games: centring and cornering\n"
"forces decoded from the game's own drive-board commands,\n"
"plus an impact jolt when you hit something."
msgstr ""
"نیروی فرمان در بازی‌های رانندگی: نیروهای بازگشت به مرکز\n"
"و پیچ که از فرمان‌های برد رانندگی خود بازی رمزگشایی می‌شوند،\n"
"به‌علاوه یک ضربه هنگام برخورد با چیزی."

#: src/osd/gui.cpp
#, no-c-format
msgid "Resistance"
msgstr "مقاومت"

#: src/osd/gui.cpp
#, no-c-format
msgid "Invert force feedback"
msgstr "معکوس کردن بازخورد نیرو"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"For a wheel whose driver pushes the wrong way: it pulls\n"
"away from the centre instead of bringing it back, and\n"
"the game's forces go the opposite way."
msgstr ""
