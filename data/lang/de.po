#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Wait for vertical blank before presenting.\n"
"Prevents tearing but adds up to one frame of latency."
msgstr ""
"Vor der Ausgabe auf die vertikale Austastlücke warten.\n"
"Verhindert Tearing, kostet aber bis zu ein Bild Latenz."

#: src/osd/gui.cpp
#, no-c-format
msgid "Notifications"
msgstr "Meldungen"

#: src/osd/gui.cpp
#, no-c-format
msgid "Automatic (system)"
msgstr "Automatisch (System)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Language"
msgstr "Sprache"

#: src/osd/gui.cpp
#, no-c-format
msgid "GPU"
msgstr "GPU"

#: src/osd/gui.cpp
#, no-c-format
msgid "Auto (best)"
msgstr "Auto (beste)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Renderer"
msgstr "Renderer"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "Software"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"Welcher Renderer das Spiel zeichnet. Gilt ab dem\n"
"nächsten Start – Einstellungen speichern und neu starten."

#: src/osd/gui.cpp
#, no-c-format
msgid "Window size"
msgstr "Fenstergröße"

#: src/osd/gui.cpp
#, no-c-format
msgid "Width"
msgstr "Breite"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "Höhe"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (nativ)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D-Renderskalierung"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"Interne 3D-Renderauflösung. Höher ergibt schärferes 3D\n"
"(2D/HUD bleibt scharf). Nur GPU-Backends; der Software-\n"
"Renderer bleibt nativ. Gilt ab dem nächsten Start –\n"
"Einstellungen speichern und neu starten."

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "Bilinear"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "Ganzzahlig"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "Nächster Nachbar"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "Scharf-bilinear"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D-Skalierung"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"Wie das Bild auf das Fenster vergrößert wird.\n"
"Scharf-bilinear hält 2D-Text scharf, ohne das Flimmern,\n"
"das Nächster Nachbar bei krummen Fenstergrößen zeigt.\n"
"Ganzzahlig rastet auf ein ganzes Vielfaches ein\n"
"(pixelgenau, mit schwarzen Balken). Wirkt sofort."

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (Arcade)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "Quadratische Pixel"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "Strecken"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "Seitenverhältnis"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 ist die Form des Arcade-Monitors (Standard).\n"
"Quadratische Pixel zeigt rohe 496x384 (etwas schmal).\n"
"Strecken füllt das ganze Fenster. Wirkt sofort."

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT-Filter"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"Ein kosmetischer Arcade-Monitor-Look über dem fertigen Bild:\n"
"Scanlines, RGB-Lochmaske, Leuchten und optionale\n"
"Bildschirmwölbung. Rein optisch; wirkt sofort."

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "Scanlines"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "Maske"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "Leuchten"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "Wölbung"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "Verbesserung (kosmetisch, über die Originalhardware hinaus)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "Anisotrop"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "Originalgetreu"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D-Texturfilter"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(nicht unterstützt)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "Diese GPU meldet keine anisotrope Filterung."

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "Anisotropie"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D-Hochskalierung"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"Kanten der 2D-Ebenen glätten (HUD, Text, Menüs). xBR und\n"
"ScaleFX runden Diagonalen; Originalgetreu behält scharfe\n"
"Pixel. Wirkt sofort."

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "Überblendet"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "Raster"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "Transparenz"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"Die Hardware zeichnet durchsichtige Flächen (Lichter, Glas,\n"
"Schatten) als Schachbrettmuster. Überblendet zeichnet die\n"
"50% durchsichtige Fläche, die gemeint ist. Wirkt sofort."

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "Eigene Texturen"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"Ersetzt die 3D-Texturen des Spiels durch Bilder aus\n"
"saves/textures/<game>/load, benannt wie beim Dump. Nur\n"
"GPU-Renderer; Neu laden übernimmt bearbeitete Dateien."

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu geladen"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "Neu laden"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "Texturen dumpen"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"Sammelt jede 3D-Textur, die das Spiel zeichnet, und schreibt\n"
"sie samt index.html zum Durchsehen nach saves/textures/<game>/dump,\n"
"wenn das Spiel endet oder dies ausgeschaltet wird."

