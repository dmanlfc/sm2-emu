msgstr "رینڈرر"

#: src/osd/gui.cpp
#, no-c-format
msgid "Software"
msgstr "سافٹ ویئر"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Which renderer draws the game. Applies on the\n"
"next launch - save settings and relaunch."
msgstr ""
"کون سا رینڈرر گیم بناتا ہے۔ اگلی بار چلانے پر لاگو\n"
"ہوتا ہے - ترتیبات محفوظ کر کے دوبارہ چلائیں۔"

#: src/osd/gui.cpp
#, no-c-format
