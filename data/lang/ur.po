msgstr "چوڑائی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Height"
msgstr "اونچائی"

#: src/osd/gui.cpp
#, no-c-format
msgid "1x (native)"
msgstr "1x (اصل)"

#: src/osd/gui.cpp
#, no-c-format
msgid "8x (4K)"
msgstr "8x (4K)"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D render scale"
msgstr "3D رینڈر پیمانہ"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Internal 3D rendering resolution. Higher is crisper 3D\n"
"(2D/HUD stays sharp). GPU backends only; the software\n"
"renderer stays native. Applies on the next launch - save\n"
"settings and relaunch."
msgstr ""
"اندرونی 3D رینڈرنگ ریزولوشن۔ زیادہ قدر سے 3D زیادہ واضح\n"
"(2D/HUD تیز رہتا ہے)۔ صرف GPU بیک اینڈ؛ سافٹ ویئر\n"
"رینڈرر اصل پر رہتا ہے۔ اگلی بار چلانے پر لاگو ہوتا ہے -\n"
"ترتیبات محفوظ کر کے دوبارہ چلائیں۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Bilinear"
msgstr "بائی لینیئر"

#: src/osd/gui.cpp
#, no-c-format
msgid "Integer"
msgstr "عدد صحیح"

#: src/osd/gui.cpp
#, no-c-format
msgid "Nearest"
msgstr "قریب ترین"

#: src/osd/gui.cpp
#, no-c-format
msgid "Sharp-bilinear"
msgstr "تیز بائی لینیئر"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D scaling"
msgstr "2D اسکیلنگ"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"How the frame is magnified to the window.\n"
"Sharp-bilinear keeps 2D text crisp without the shimmer\n"
"nearest shows at non-integer window sizes. Integer snaps\n"
"to a whole multiple (pixel-perfect, with black bars).\n"
"Applies live."
msgstr ""
"فریم کو ونڈو تک کیسے بڑا کیا جائے۔\n"
"تیز بائی لینیئر 2D متن کو اس جھلملاہٹ کے بغیر واضح رکھتا ہے\n"
"جو قریب ترین غیر عدد صحیح سائز پر دکھاتا ہے۔ عدد صحیح\n"
"پورے گنا پر رکھتا ہے (پکسل درست، سیاہ پٹیوں کے ساتھ)۔\n"
"فوراً لاگو ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "4:3 (arcade)"
msgstr "4:3 (آرکیڈ)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Square pixels"
msgstr "مربع پکسل"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stretch"
msgstr "کھینچیں"

#: src/osd/gui.cpp
#, no-c-format
msgid "Aspect"
msgstr "تناسب"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"4:3 is the arcade monitor's shape (the default).\n"
"Square pixels shows the raw 496x384 (slightly narrow).\n"
"Stretch fills the whole window. Applies live."
msgstr ""
"4:3 آرکیڈ مانیٹر کی شکل ہے (طے شدہ)۔\n"
"مربع پکسل خام 496x384 دکھاتا ہے (کچھ تنگ)۔\n"
"کھینچیں پوری ونڈو بھر دیتا ہے۔ فوراً لاگو ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "CRT filter"
msgstr "CRT فلٹر"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"A cosmetic arcade-monitor look over the finished frame:\n"
"scanlines, an RGB shadow mask, glow and optional screen\n"
"curvature. Purely visual; applies live."
msgstr ""
"تیار فریم پر آرکیڈ مانیٹر جیسی سجاوٹی شکل:\n"
"اسکین لائنیں، RGB شیڈو ماسک، چمک اور اختیاری اسکرین\n"
"خمیدگی۔ صرف بصری؛ فوراً لاگو ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Scanlines"
msgstr "اسکین لائنیں"

#: src/osd/gui.cpp
#, no-c-format
msgid "Mask"
msgstr "ماسک"

#: src/osd/gui.cpp
#, no-c-format
msgid "Glow"
msgstr "چمک"

#: src/osd/gui.cpp
#, no-c-format
msgid "Curvature"
msgstr "خمیدگی"

#: src/osd/gui.cpp
#, no-c-format
msgid "Enhancement (cosmetic, beyond the original hardware)"
msgstr "بہتری (سجاوٹی، اصل ہارڈ ویئر سے آگے)"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropic"
msgstr "اینی سوٹروپک"

#: src/osd/gui.cpp
#, no-c-format
msgid "Faithful"
msgstr "اصل جیسا"

#: src/osd/gui.cpp
#, no-c-format
msgid "3D texture filter"
msgstr "3D ٹیکسچر فلٹر"

#: src/osd/gui.cpp
#, no-c-format
msgid "(unsupported)"
msgstr "(غیر معاون)"

#: src/osd/gui.cpp
#, no-c-format
msgid "This GPU does not report anisotropic filtering."
msgstr "یہ GPU اینی سوٹروپک فلٹرنگ کی اطلاع نہیں دیتا۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Anisotropy"
msgstr "اینی سوٹروپی"

#: src/osd/gui.cpp
#, no-c-format
msgid "2D upscale"
msgstr "2D اپ اسکیل"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Edge-smooth the 2D layers (HUD, text, menus). xBR and\n"
"ScaleFX round diagonals; Faithful keeps crisp pixels.\n"
"Applies live."
msgstr ""
"2D تہوں (HUD، متن، مینو) کے کنارے ہموار کریں۔ xBR اور\n"
"ScaleFX ترچھی لکیریں گول کرتے ہیں؛ اصل جیسا پکسل تیز رکھتا ہے۔\n"
"فوراً لاگو ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Blended"
msgstr "ملا ہوا"

#: src/osd/gui.cpp
#, no-c-format
msgid "Stipple"
msgstr "نقطہ دار"

#: src/osd/gui.cpp
#, no-c-format
msgid "Translucency"
msgstr "نیم شفافیت"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"The hardware draws see-through surfaces (lights, glass,\n"
"shadows) as a checkerboard. Blended draws the 50%\n"
"see-through surface it's trying to achieve. Applies live."
msgstr ""
"ہارڈ ویئر شفاف سطحوں (روشنیاں، شیشہ، سائے) کو\n"
"شطرنجی خانوں کی شکل میں بناتا ہے۔ ملا ہوا وہ 50%\n"
"شفاف سطح بناتا ہے جو مقصود ہے۔ فوراً لاگو ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Custom textures"
msgstr "حسب منشا ٹیکسچر"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Replace the game's 3D textures with images saved in\n"
"saves/textures/<game>/load, named as dumped. GPU\n"
"renderers only; Reload picks up edited files."
msgstr ""
"گیم کے 3D ٹیکسچر کو saves/textures/<game>/load میں\n"
"ڈمپ والے ناموں سے محفوظ تصاویر سے بدلیں۔ صرف GPU\n"
"رینڈرر؛ دوبارہ لوڈ ترمیم شدہ فائلیں اٹھا لیتا ہے۔"

#: src/osd/gui.cpp
#, c-format
msgid "%zu loaded"
msgstr "%zu لوڈ ہوئے"

#: src/osd/gui.cpp
#, no-c-format
msgid "Reload"
msgstr "دوبارہ لوڈ"

#: src/osd/gui.cpp
#, no-c-format
msgid "Dump textures"
msgstr "ٹیکسچر ڈمپ کریں"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Collect every 3D texture the game draws and write them,\n"
"with an index.html to browse, to saves/textures/<game>/dump\n"
"when the game exits or this is turned off."
msgstr ""
"گیم کے بنائے ہر 3D ٹیکسچر کو جمع کر کے، دیکھنے کے لیے\n"
"index.html کے ساتھ، saves/textures/<game>/dump میں لکھیں\n"
"جب گیم بند ہو یا یہ آپشن بند کیا جائے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Audio"
msgstr "آڈیو"

#: src/osd/gui.cpp
#, no-c-format
msgid "Paths"
msgstr "راستے"

#: src/osd/gui.cpp
#, no-c-format
msgid "Browse..."
msgstr "براؤز..."

#: src/osd/gui.cpp
#, no-c-format
msgid "Config directory"
msgstr "کنفیگ ڈائریکٹری"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where sm2-emu.ini is read from and saved to.\n"
"Set with --config <dir>; cannot be changed here."
msgstr ""
"جہاں سے sm2-emu.ini پڑھی اور محفوظ کی جاتی ہے۔\n"
"--config <dir> سے مقرر ہوتی ہے؛ یہاں تبدیل نہیں ہو سکتی۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "ROM directory"
msgstr "ROM ڈائریکٹری"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Where the ROM archives live. A game launched by name is\n"
"loaded from here as <name>.zip or <name>.7z."
msgstr ""
"جہاں ROM آرکائیو رکھے ہیں۔ نام سے چلایا گیا گیم یہاں سے\n"
"<name>.zip یا <name>.7z کے طور پر لوڈ ہوتا ہے۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Saves directory"
msgstr "سیو ڈائریکٹری"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Battery-backed saves: per-game NVRAM (.nv) and EEPROM\n"
"(.eeprom) images -- high scores and operator settings."
msgstr ""
"بیٹری والی سیو: ہر گیم کی NVRAM (.nv) اور EEPROM\n"
"(.eeprom) فائلیں -- ہائی اسکور اور آپریٹر ترتیبات۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Screenshots directory"
msgstr "اسکرین شاٹ ڈائریکٹری"

#: src/osd/gui.cpp
#, no-c-format
msgid "Where F12 screenshots are written."
msgstr "جہاں F12 اسکرین شاٹ لکھے جاتے ہیں۔"

#: src/osd/gui.cpp
#, no-c-format
msgid "Scrape artwork online"
msgstr "آن لائن آرٹ ورک حاصل کریں"

#: src/osd/gui.cpp
#, no-c-format
msgid ""
"Let the game picker fetch box art and descriptions from\n"
"ArcadeDB over the network. Off keeps sm2-emu offline: the\n"
"picker still lists and launches every game, with placeholder\n"
"tiles and no descriptions."
msgstr ""
"گیم چننے والے کو نیٹ ورک پر ArcadeDB سے باکس آرٹ اور\n"
"تفصیلات لانے دیں۔ بند ہونے پر sm2-emu آف لائن رہتا ہے:\n"
"چننے والا پھر بھی ہر گیم دکھاتا اور چلاتا ہے، عارضی\n"
"ٹائلوں کے ساتھ اور بغیر تفصیلات کے۔"

