# Script-mode helper: embed a GLSL source file as a C++ raw string literal,
# for the GL backend, which compiles it at runtime (see EmbedSpirv.cmake for
# the Vulkan path).
#
#   cmake -DSM2_IN=x.frag -DSM2_OUT=x_glsl.h -DSM2_SYMBOL=x -DSM2_SOURCE_NAME=x.frag
#         -P EmbedGlsl.cmake

foreach(var SM2_IN SM2_OUT SM2_SYMBOL)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedGlsl.cmake: ${var} is required")
    endif()
endforeach()

if(NOT DEFINED SM2_SOURCE_NAME)
    get_filename_component(SM2_SOURCE_NAME "${SM2_IN}" NAME)
endif()

file(READ "${SM2_IN}" source)

# The raw string delimiter must not appear in the payload, or the embedded
# shader would be silently truncated.
string(FIND "${source}" ")glsl\"" collision)
if(NOT collision EQUAL -1)
    message(FATAL_ERROR
        "EmbedGlsl.cmake: ${SM2_IN} contains the raw-string delimiter "
        "')glsl\"' this script uses, which would truncate the embedded source. "
        "Pick a different delimiter in this script if a shader genuinely needs "
        "that text.")
endif()

get_filename_component(out_name "${SM2_OUT}" NAME)
string(TOUPPER "${out_name}" guard)
string(REGEX REPLACE "[^A-Za-z0-9]" "_" guard "${guard}")

file(WRITE "${SM2_OUT}"
"// Generated by cmake/EmbedGlsl.cmake. Do not edit.
// Source: ${SM2_SOURCE_NAME}
#ifndef SM2_GENERATED_${guard}
#define SM2_GENERATED_${guard}

namespace sm2::shaders {

inline constexpr const char* ${SM2_SYMBOL} = R\"glsl(
${source})glsl\";

}  // namespace sm2::shaders

#endif  // SM2_GENERATED_${guard}
")
